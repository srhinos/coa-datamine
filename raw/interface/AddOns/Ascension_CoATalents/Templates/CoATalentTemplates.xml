    <ScrollFrame name="CoATreeFXFrameTemplate" virtual="true">
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "CoATreeFXMixin")
            </OnLoad>
        </Scripts>
        <ScrollChild>
            <Frame name="$parentChild" parentKey="Child">
                <Frames>
                    <Frame name="$parentCloudsContainer" parentKey="CloudsContainer">
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                            <Anchor point="BOTTOMLEFT"/>
                        </Anchors>
                        <Layers>
                            <Layer level="BORDER">
                                <Texture name="$parentClouds1" parentKey="Clouds1" alpha="0.05" alphaMode="ADD">
                                    <Anchors>
                                        <Anchor point="TOPLEFT"/>
                                        <Anchor point="BOTTOMLEFT"/>
                                    </Anchors>
                                </Texture>
                                <Texture name="$parentClouds2" parentKey="Clouds2" alpha="0.05" alphaMode="ADD">
                                    <Anchors>
                                        <Anchor point="TOPLEFT" relativeTo="$parentClouds1" relativePoint="TOPRIGHT"/>
                                        <Anchor point="BOTTOMLEFT" relativeTo="$parentClouds1" relativePoint="BOTTOMRIGHT"/>
                                    </Anchors>
                                </Texture>
                            </Layer>
                        </Layers>
                        <Animations>
                            <AnimationGroup parentKey="Anim" looping="REPEAT" inherits="AnimationOneShotTemplate">
                                <Translation order="1" offsetX="0" offsetY="0"/>
                                <Translation order="2" offsetX="-1160" offsetY="0" duration="80"/>
                                <Translation order="3" offsetX="1160" offsetY="0"/>
                            </AnimationGroup>
                        </Animations>
                    </Frame>
                </Frames>
                <Layers>
                    <Layer level="BORDER">
                        <Texture parentKey="AirParticlesClose" alpha="0" alphaMode="ADD">
                            <Anchors>
                                <Anchor point="CENTER" relativePoint="CENTER"/>
                            </Anchors>
                            <Animations>
                                <AnimationGroup parentKey="Anim" looping="REPEAT">
                                    <Translation order="1" offsetX="300" offsetY="0"/>
                                    <Translation order="2" offsetX="-600" offsetY="0" duration="27"/>
                                    <Alpha order="2" change="0.15" duration="5" smoothing="NONE"/>
                                    <Alpha order="2" change="-0.15" startDelay="22" duration="5" smoothing="NONE"/>
                                    <Rotation order="2" duration="36" degrees="20"/>

                                    <Translation order="3" offsetX="600" offsetY="0"/>
                                </AnimationGroup>
                            </Animations>
                        </Texture>

                        <Texture parentKey="AirParticlesFar" alpha="0" alphaMode="ADD">
                            <Size x="800" y="473"/>
                            <Anchors>
                                <Anchor point="CENTER" relativePoint="CENTER"/>
                            </Anchors>
                            <Animations>
                                <AnimationGroup parentKey="Anim" looping="REPEAT">
                                    <Translation order="1" offsetX="100" offsetY="0"/>
                                    <Translation order="2" offsetX="-200" offsetY="0" duration="36"/>
                                    <Alpha order="2" change="0.14" duration="5" smoothing="NONE"/>
                                    <Alpha order="2" change="-0.14" startDelay="31" duration="5" smoothing="NONE"/>
                                    <Rotation order="2" duration="36" degrees="-20"/>
                                    
                                    <Translation order="3" offsetX="200" offsetY="0"/>
                                </AnimationGroup>
                            </Animations>
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>
        </ScrollChild>
    </ScrollFrame>
    
