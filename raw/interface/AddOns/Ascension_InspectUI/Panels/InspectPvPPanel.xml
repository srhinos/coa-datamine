<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="InspectPvPPanel.lua"/>

    <Frame name="InspectPvPStatTemplate" virtual="true">
        <Size x="260" y="88"/>
        <Layers>
            <Layer level="BORDER">
                <FontString name="$parentBGType" parentKey="BGType" inherits="GameFontHighlightLarge">
                    <Anchors>
                        <Anchor point="TOPLEFT" y="-28"/>
                    </Anchors>
                </FontString>
                
                <FontString name="$parentRatingLabel" parentKey="RatingLabel" inherits="GameFontNormal" text="PVP_RATING">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentBGType" relativePoint="BOTTOMLEFT" y="-10"/>
                    </Anchors>
                </FontString>
                
                <FontString name="$parentRating" parentKey="Rating" inherits="GameFontHighlight" text="0">
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentRatingLabel" relativePoint="RIGHT" x="4"/>
                    </Anchors>
                </FontString>
                
                <FontString name="$parentRecordLabel" parentKey="RecordLabel" inherits="GameFontNormal" text="RECORD">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentRatingLabel" relativePoint="BOTTOMLEFT" y="-8"/>
                    </Anchors>
                </FontString>
                
                <FontString name="$parentRecord" parentKey="Record" inherits="GameFontHighlight" text="0">
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentRecordLabel" relativePoint="RIGHT" x="4"/>
                    </Anchors>
                </FontString>
                
                <Texture name="$parentRankIcon" parentKey="RankIcon">
                    <Size x="50" y="50"/>
                    <Anchors>
                        <Anchor point="RIGHT" y="-8"/>
                    </Anchors>
                </Texture>

                <FontString name="$parentRank" parentKey="Rank" inherits="GameFontHighlight" text="PVP_TIER_UNRANKED">
                    <Anchors>
                        <Anchor point="TOP" relativeTo="$parentRankIcon" relativePoint="BOTTOM" y="-2"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="InspectPvPPanel" setAllPoints="true" parent="AscensionInspectFrameInset">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground" parentKey="Background">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="2" y="-2"/>
                        <Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        
        <Frames>
            <Frame name="$parentHonorableKills" parentKey="HonorableKills">
                <Size x="370" y="42"/>
                <Anchors>
                    <Anchor point="TOP"/>
                </Anchors>
                <Layers>
                    <Layer>
                        <FontString name="$parentText" parentKey="Text" text="HONORABLE_KILLS" justifyV="BOTTOM" inherits="GameFontNormalLarge" setAllPoints="true"/>
                    </Layer>
                </Layers>
            </Frame>

            <Frame name="$parentArena1v1" parentKey="Arena1v1" inherits="InspectPvpStatTemplate">
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentHonorableKills" relativePoint="BOTTOM"/>
                </Anchors>

                <Layers>
                    <Layer>
                        <Texture name="$parentDiv" file="Interface\Common\ui-tooltipdivider-transparent">
                            <Size x="315" y="8"/>
                            <Anchors>
                                <Anchor point="BOTTOM" y="-12"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                
                <Scripts>
                    <OnLoad>
                        self.BGType:SetText(ARENA_BATTLES_1V1)
                    </OnLoad>
                </Scripts>
            </Frame>

            <Frame name="$parentArena2v2" parentKey="Arena2v2" inherits="InspectPvpStatTemplate">
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentArena1v1" relativePoint="BOTTOM"/>
                </Anchors>
                
                <Layers>
                    <Layer>
                        <Texture name="$parentDiv" file="Interface\Common\ui-tooltipdivider-transparent">
                            <Size x="315" y="8"/>
                            <Anchors>
                                <Anchor point="BOTTOM" y="-18"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>

                <Scripts>
                    <OnLoad>
                        self.BGType:SetText(ARENA_BATTLES_2V2)
                    </OnLoad>
                </Scripts>
            </Frame>

            <Frame name="$parentArena3v3" parentKey="Arena3v3" inherits="InspectPvpStatTemplate">
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentArena2v2" relativePoint="BOTTOM"/>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        self.BGType:SetText(ARENA_BATTLES_3V3)
                    </OnLoad>
                </Scripts>
            </Frame>
        </Frames>
        
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "InspectPvPPanelMixin")
            </OnLoad>
        </Scripts>
    </Frame>
</Ui>