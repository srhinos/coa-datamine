<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="ManastormLoadout.lua"/>
    
    <Button name="ManastormLoadoutSlotTemplate" inherits="SpellIconTemplate" virtual="true">
        <Size x="38" y="38"/>
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "ManastormLoadoutSlotMixin")
            </OnLoad>
            <OnEvent function="OnEventToMethod"/>
        </Scripts>
    </Button>
    
    <Frame name="ManastormLoadoutTemplate" inherits="HorizontalLayoutFrame" virtual="true">
        <Size x="200" y="50"/>
        
        <Attributes>
            <Attribute name="spacing" value="8"/>
        </Attributes>

        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "HorizontalLayoutMixin", "ManastormLoadoutMixin")
            </OnLoad>
        </Scripts>
    </Frame>
</Ui>