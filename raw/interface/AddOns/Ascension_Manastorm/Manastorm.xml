<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="Manastorm.lua"/>

    <Frame name="ManastormLeaveFrame" parent="UIParent" inherits="LeaveActivityTemplate">
        <Anchors>
            <Anchor point="TOP" x="0" y="-180"/>
        </Anchors>
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "ManastormLeaveMixin")
            </OnLoad>
            <OnEvent function="OnEventToMethod"/>
        </Scripts>
    </Frame>
    
    <Frame name="ManastormObjectiveTracker" parent="UIParent" inherits="ObjectiveTrackerTemplate">
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "ManastormObjectiveTrackerMixin")
            </OnLoad>
        </Scripts>
    </Frame>
</Ui>