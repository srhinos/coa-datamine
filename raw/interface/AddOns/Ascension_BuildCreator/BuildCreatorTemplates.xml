                                self.scrollDownButton = _G[self.scrollbar:GetName().."ScrollDownButton"]
                            </OnLoad>
                            <OnVerticalScroll>
                                self.scrollbar:SetValue(offset)
                                local min, max
                                min, max = self.scrollbar:GetMinMaxValues()

                                if offset == 0 then
                                    self.scrollUpButton:Disable()
                                else
                                    self.scrollUpButton:Enable()
                                end

                                if (self.scrollbar:GetValue() - max) == 0 then
                                    self.scrollDownButton:Disable()
                                else
                                    self.scrollDownButton:Enable()
                                end
                                
                                self:GetParent():GetParent():OnVerticalScroll(offset)
                            </OnVerticalScroll>
