    <Button name="ChallengesSpellIconTemplate" inherits="SpellIconTemplate" virtual="true">
        <Size x="42" y="42"/>

        <Frames>
            <Frame name="$parentAuraType" parentKey="AuraType" enableMouse="true">
                <Size x="22" y="22"/>
                <Anchors>
                    <Anchor point="CENTER" relativePoint="BOTTOMRIGHT" x="-6" y="6"/>
                </Anchors>
                
                <Layers>
                    <Layer>
                        <Texture name="$parentIcon" parentKey="Icon" setAllPoints="true"/>
                    </Layer>
                </Layers>
                
                <Scripts>
                    <OnEnter>
                        if self.tooltipTitle then
                            GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                            GameTooltip:SetText(self.tooltipTitle, 1, 1, 1, 1, false)
                            if self.tooltipText then
                                GameTooltip:AddLine(self.tooltipText, nil, nil, nil, true)
                            end
                            GameTooltip:Show()
                        end
                    </OnEnter>
                    <OnLeave function="GameTooltip_Hide"/>
                </Scripts>
            </Frame>
        </Frames>
    </Button>
    
    <Button name="ChallengeRewardTemplate" enableMouse="true" virtual="true">
        <Size x="38" y="38"/>
        
        <Layers>
            <Layer level="BORDER">
                <Texture name="$parentIcon" parentKey="Icon">
                    <Size x="38" y="38"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
            
            <Layer level="ARTWORK">
                <Texture name="$parentIconBorder" parentKey="IconBorder">
                    <Size x="58" y="58"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeTo="$parentIcon" y="-1"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="OVERLAY">
                <FontString name="$parentCount" parentKey="Count" justifyH="RIGHT" inherits="PTFontHighlightOutline">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="4" y="-2"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Scripts>
            <OnEnter>
                if self.itemID then
                    GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                    GameTooltip:SetHyperlink("item:"..self.itemID)
                    GameTooltip:Show()
                elseif self.achievementID then
                    GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                    GameTooltip:SetHyperlink(GetAchievementLink(self.achievementID))
                    GameTooltip:Show()
                elseif self.tooltipTitle then
                    GameTooltip_GenericTooltip(self)
                end
                self:GetParent():LockHighlight()
            </OnEnter>
            <OnLeave>
                self:GetParent():UnlockHighlight()
                GameTooltip:Hide()
            </OnLeave>
            <OnClick>
                self:GetParent():Click()
            </OnClick>
        </Scripts>
    </Button>
    
