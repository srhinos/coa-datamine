                            <Frame name="$parentLeaderboardScroll" parentKey="LeaderboardScroll" hidden="true" inherits="ProportionalScrollListTemplate">
                                <Size x="368" y="166"/>
                                <Anchors>
                                    <Anchor point="TOPLEFT" relativeTo="$parentSubText" relativePoint="BOTTOMLEFT" y="-2"/>
                                </Anchors>
                            </Frame>
                        </Frames>

                        <Scripts>
                            <OnLoad>
                                MixinAndLoadScripts(self, "ChallengeExtendedInfoMixin")
                            </OnLoad>
                        </Scripts>

                        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
                            <EdgeSize  val="16"/>
                            <TileSize val="16"/>
                            <BackgroundInsets left="5" right="5" top="5" bottom="5"/>
                            <Color r="0" g="0" b="0" a="0.8"/>
                            <BorderColor r="0.5" g="0.5" b="0.5"/>
                        </Backdrop>
                    </Frame>

                    <Button name="$parentActivateButton" parentKey="ActivateButton" text="ACTIVATE" inherits="SharedButtonTemplate">
                        <Size x="150" y="32"/>
                        <Anchors>
                            <Anchor point="TOPRIGHT" relativeTo="$parentTabContent" relativePoint="BOTTOMRIGHT"/>
                        </Anchors>

                        <Scripts>
                            <OnClick>
                                self:GetParent():GetParent():ToggleGameMode()
                            </OnClick>
                            <OnEnter>
                                if not self.disabledReasons then return end
                                GameTooltip:SetOwner(self, "ANCHOR_TOP")
                                GameTooltip:SetText(CHALLENGES_GAME_MODE_DISABLED)
                                for _, reason in ipairs(self.disabledReasons) do
                                    GameTooltip:AddLine(_G[reason] or reason, 1, 0, 0, true)
                                end
                                GameTooltip:Show()
                            </OnEnter>
                        </Scripts>
                    </Button>
                </Frames>
            </Frame>
        </Frames>

        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "GameModeItemTemplate")
            </OnLoad>
        </Scripts>

        <PushedTextOffset x="0" y="0"/>

        <ButtonText name="$parentText" parentKey="Text" wordwrap="false" justifyH="LEFT" inherits="PTFontNormalOutlineHuge2">
            <Size x="0" y="30"/>
            <Anchors>
                <Anchor point="TOPLEFT" relativeTo="$parentIconBorder" relativePoint="TOPRIGHT" x="10"/>
            </Anchors>
        </ButtonText>

        <NormalTexture setAllPoints="true"/>
        <HighlightTexture alphaMode="ADD">
            <Anchors>
                <Anchor point="TOPLEFT" x="8" y="-7"/>
                <Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" x="-8" y="-84"/>
            </Anchors>
        </HighlightTexture>
    </Button>
</Ui>