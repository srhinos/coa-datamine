                        </Anchors>
                        
                        <Scripts>
                            <OnClick>
                                self:GetParent():GetParent():ToggleChallengeActive()
                            </OnClick>
                            <OnEnter>
                                if not self.disabledReasons then return end
                                GameTooltip:SetOwner(self, "ANCHOR_TOP")
                                GameTooltip:SetText(CHALLENGES_CANNOT_ACTIVATE)
                                for _, reason in ipairs(self.disabledReasons) do
