                                <Anchor point="CENTER" x="0" y="0"/>
                            </Anchors>
                        </Texture>

                        <Texture name="$parentMentorRequirement" parentKey="MentorRequirement" hidden="true">
                            <Size x="18" y="14"/>
                            <Anchors>
                                <Anchor point="CENTER" relativePoint="TOPLEFT" x="4" y="-4"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                
                <Frames>
                    <Frame name="$parentQuestIcon" parentKey="QuestIcon">
                        <Size x="24" y="24"/>
                        <Anchors>
                            <Anchor point="BOTTOMRIGHT" x="4" y="-2"/>
                        </Anchors>
                        <Layers>
                            <Layer level="ARTWORK">
                                <Texture name="$parentTexture" parentKey="Texture" setAllPoints="true"/>
                            </Layer>
                        </Layers>
                    </Frame>
                </Frames>
            </Frame>

            <Button name="$parentReward" parentKey="Reward" inherits="PathTutorialRewardTemplate">
                <Anchors>
                    <Anchor point="RIGHT" x="-10" y="-2"/>
                </Anchors>
                
                <!--<Frames>
                    <Frame name="$parentClaimIcon" parentKey="ClaimIcon" hidden="true">
                        <Size x="41" y="26"/>
                        <Anchors>
                            <Anchor point="CENTER" relativePoint="BOTTOM" y="4"/>
                        </Anchors>

                        <Layers>
                            <Layer level="BACKGROUND">
                                <Texture name="$parentGlow" parentKey="Glow" setAllPoints="true"/>
                            </Layer>
                            <Layer>
                                <FontString name="$parentText" parentKey="Text" text="CLAIM" inherits="GameFontNormal">
                                    <Anchors>
                                        <Anchor point="CENTER" y="1"/>
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>

                        <Scripts>
                            <OnLoad>
                                self.Glow:SetAtlas("collections-newglow", Const.TextureKit.IgnoreAtlasSize)
                            </OnLoad>
                        </Scripts>
                    </Frame>
                </Frames>-->
            </Button>
            
            <Frame name="$parentNewIcon" parentKey="NewIcon" inherits="NewIconTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPRIGHT"/>
                </Anchors>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad>
                self.Pushed:SetAtlas("pta-tab-pushed", Const.TextureKit.UseAtlasSize)
                self.Normal:SetAtlas("pta-tab-normal", Const.TextureKit.UseAtlasSize)
                self.Highlight:SetAtlas("pta-tab-highlight", Const.TextureKit.UseAtlasSize)
                self.Selected:SetAtlas("pta-tab-checked", Const.TextureKit.UseAtlasSize)
                MixinAndLoadScripts(self, "PathObjectiveItemMixin")
            </OnLoad>
        </Scripts>
        
        <NormalTexture parentKey="Normal">
            <Anchors>
                <Anchor point="CENTER"/>
            </Anchors>
        </NormalTexture>

        <HighlightTexture />
    </Button>

    <Frame name="PathDisplayPanelTemplate" virtual="true">
        <Frames>
            <Frame name="$parentBorder" parentKey="Border" inherits="NineSlicePanelTemplate2">
                <Anchors>
                    <Anchor point="TOPLEFT" y="-8"/>
                    <Anchor point="BOTTOMRIGHT" y="8"/>
                </Anchors>

                <Layers>
                    <Layer level="BORDER">
                        <Texture name="$parentLeftCover" parentKey="LeftCover" vertTile="true">
                            <Size x="167" y="128"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="4" y="-4"/>
                                <Anchor point="BOTTOMLEFT" x="4" y="4"/>
                            </Anchors>
                        </Texture>

                        <Texture name="$parentRightCover" parentKey="RightCover" vertTile="true">
                            <Size x="167" y="128"/>
                            <Anchors>
                                <Anchor point="TOPRIGHT" x="-4" y="-4"/>
                                <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                            </Anchors>
                        </Texture>
                    </Layer>

                    <Layer level="ARTWORK">
                        <Texture name="$parentBottomLeftEdge" parentKey="BottomLeftEdge">
                            <Size x="23" y="128"/>
                            <Anchors>
                                <Anchor point="BOTTOMLEFT" x="-2" y="4"/>
                            </Anchors>
                        </Texture>

                        <Texture name="$parentBottomRightEdge" parentKey="BottomRightEdge">
                            <Size x="23" y="128"/>
                            <Anchors>
                                <Anchor point="BOTTOMRIGHT" x="2" y="4"/>
                            </Anchors>
                        </Texture>
                    </Layer>

                    <Layer level="OVERLAY">
                        <Texture name="$parentBottomCover" parentKey="BottomCover" horizTile="true">
                            <Size x="256" y="42"/>
                            <Anchors>
                                <Anchor point="BOTTOMLEFT" x="8" y="8"/>
                                <Anchor point="BOTTOMRIGHT" x="-8" y="8"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Attributes>
                    <Attribute name="layoutType" value="GarrisonMissionBorder"/>
                </Attributes>

                <Scripts>
                    <OnLoad>
                        UseParentLevel(self)
                        MixinAndLoadScripts(self, "NineSlicePanelMixin")
                        self.BottomCover:SetAtlas("_GarrMission_Bg-BottomEdgeSmall", Const.TextureKit.IgnoreAtlasSize)
                        self.LeftCover:SetAtlas("!GarrMission_Bg-DarkEdge", Const.TextureKit.IgnoreAtlasSize)
                        self.RightCover:SetAtlas("!GarrMission_Bg-DarkEdge", Const.TextureKit.IgnoreAtlasSize)
                        self.RightCover:FlipX()

                        self.BottomLeftEdge:SetAtlas("GarrMission_Bg-DarkEdgeCorner", Const.TextureKit.IgnoreAtlasSize)

                        self.BottomRightEdge:SetAtlas("GarrMission_Bg-DarkEdgeCorner", Const.TextureKit.IgnoreAtlasSize)
                        self.BottomRightEdge:FlipX()
                    </OnLoad>
                </Scripts>
            </Frame>
        </Frames>
    </Frame>
    
    <Button name="PathMentorItemTemplate" inherits="ScrollListItemTextTemplate" virtual="true">
        <Size x="390" y="48"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground" parentKey="Background" setAllPoints="true">
                    <Size x="390" y="48"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="BORDER">
                <Texture name="$parentBackground2" parentKey="Background2">
                    <Size x="390" y="22"/>
                    <Anchors>
                        <Anchor point="BOTTOM"/>
                    </Anchors>
                </Texture>

                <Texture name="$parentIcon" parentKey="Icon" file="Interface\Glues\CharacterCreate\UI-CHARACTERCREATE-RACES_Round">
                    <Size x="38" y="38"/>
                    <Anchors>
                        <Anchor point="LEFT" x="4" y="2"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer>
                <Texture name="$parentIconBorder" parentKey="IconBorder">
                    <Size x="48" y="48"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeTo="$parentIcon"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="OVERLAY">
                <FontString name="$parentName" parentKey="Name" justifyH="LEFT" wordwrap="false" inherits="GameFontHighlightLarge">
                    <Anchors>
                        <Anchor point="LEFT" x="50" y="10"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        
        <Frames>
            <Frame name="$parentDropDown" parentKey="DropDown" inherits="UIDropDownMenuTemplate"/>
        </Frames>

        <HighlightTexture name="$parentHighlight" parentKey="Highlight" setAllPoints="true"/>

        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "PathMentorItemMixin")
            </OnLoad>
        </Scripts>
    </Button>

    <Button name="PathAppendixItemTemplate" inherits="ScrollListItemTemplate" virtual="true">
        <Size x="416" y="54"/>
        <Layers>
            <Layer level="ARTWORK">
