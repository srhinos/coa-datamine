<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    
    <Button name="PTAMentorSpecializationIconTemplate" virtual="true">
        <Size x="16" y="16"/>
        <Scripts>
            <OnEnter function="GameTooltip_GenericTooltip"/>
            <OnLeave function="GameTooltip_Hide"/>
        </Scripts>
        <HighlightTexture alphaMode="ADD"/>
    </Button>
    
    <CheckButton name="PTATabButtonTemplate" inherits="GarrTabBottomTemplate" virtual="true">
        <Size x="88" y="48"/>
        
        <Frames>
            <Frame name="$parentNewIcon" parentKey="NewIcon" inherits="SmallNewIconTemplate" hidden="true">
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="2" y="-2"/>
                </Anchors>
            </Frame>
        </Frames>
        <NormalFont style="GameFontNormal"/>
        <HighlightFont style="GameFontHighlight"/>
        <DisabledFont style="GameFontDisabled"/>
    </CheckButton> 
    
    <CheckButton name="PTAMentorSpecializationTemplate" inherits="SquareIconCheckButtonTemplate" virtual="true">
        <Size x="32" y="32"/>
        
        <Scripts>
            <OnClick>
                PlaySound(SOUNDKIT.UCHATSCROLLBUTTON_70)
                if self:GetBoolValue() then
                    C_Tutorial.AddMentorSpecialization(self:GetID())
                else
                    C_Tutorial.RemoveMentorSpecialization(self:GetID())
                end
            </OnClick>
        </Scripts>
        
        <ButtonText name="$parentText" parentKey="Text" inherits="GameFontHighlight">
            <Anchors>
                <Anchor point="LEFT" relativePoint="RIGHT"/>
            </Anchors>
        </ButtonText>
    </CheckButton> 

    <SimpleHTML name="PTADescriptionTemplate" inherits="DynamicSimpleHTMLTemplate" virtual="true">
        <FontString inherits="GameFontHighlightMedium" justifyH="CENTER">
            <Color r="1" g="0.82" b="0"/>
        </FontString>
        <FontStringHeader1 inherits="GameFontHighlightGiant" justifyH="CENTER"/>
        <FontStringHeader2 inherits="GameFontHighlightLarge2" justifyH="CENTER"/>
        <FontStringHeader3 inherits="GameFontHighlightLarge" justifyH="CENTER"/>
    </SimpleHTML>

    <Button name="PathTutorialRewardTemplate" motionScriptsWhileDisabled="true" virtual="true">
        <Size x="32" y="32"/>

        <Layers>
        	<Layer level="BACKGROUND">
        		<Texture name="$parentBgRing" parentKey="BgRing" alphaMode="ADD" hidden="true">
					<Size x="56" y="56"/>
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="0"/>
                    </Anchors>
                    <Animations>
                        <AnimationGroup parentKey="Animation" looping="REPEAT">
                            <Rotation duration="60" degrees="360"/>
                        </AnimationGroup>
                    </Animations>
        		</Texture>
        	</Layer>
        </Layers>

        <Scripts>
            <OnLoad>
            	self.BgRing.Animation:Play()
            	self.BgRing:SetAtlas("services-ring-large-glowspin", Const.TextureKit.IgnoreAtlasSize)
                self:SetNormalAtlas("pta-loot-normal")
                self:SetDisabledAtlas("pta-loot-disable")
                self:SetHighlightAtlas("pta-loot-highlight")
            </OnLoad>
            <OnClick>
                self:GetParent():OnRewardClick()
            </OnClick>
            <OnEnter>
                self:GetParent():OnRewardEnter()
            </OnEnter>
            <OnLeave function="GameTooltip_Hide"/>
        </Scripts>

        <NormalTexture>
        	<Size x="56" y="56"/>
        	<Anchors>
        		<Anchor point="CENTER" x="0" y="0"/>
        	</Anchors>
        </NormalTexture>

        <HighlightTexture alphaMode="ADD">
        	<Size x="56" y="56"/>
        	<Anchors>
        		<Anchor point="CENTER" x="0" y="0"/>
        	</Anchors>
        </HighlightTexture>

        <DisabledTexture>
        	<Size x="56" y="56"/>
        	<Anchors>
        		<Anchor point="CENTER" x="0" y="0"/>
        	</Anchors>
        </DisabledTexture>
    </Button>

    <Button name="PathObjectiveItemTemplate" inherits="ScrollListItemTemplate" virtual="true">
        <Size x="416" y="54"/>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentTitle" parentKey="Title" inherits="GameFontNormal" justifyH="LEFT" maxLines="3">
                    <Size x="128" y="64"/>
                    <Anchors>
                        <Anchor point="LEFT" x="56" y="0"/>
                    </Anchors>
                    <!--<Color r="1" g="0.82" b="0"/>-->
                </FontString>
                <FontString name="$parentSummary" parentKey="Summary" inherits="GameFontNormalLarge2" justifyH="LEFT">
                    <Size x="0" y="0"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeTo="$parentTitle" relativePoint="BOTTOMRIGHT" x="8" y="0"/>
                    </Anchors>
                    <Color r="0.8" g="0.8" b="0.8"/>
                </FontString>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="Selected" alphaMode="ADD">
                    <Anchors>
