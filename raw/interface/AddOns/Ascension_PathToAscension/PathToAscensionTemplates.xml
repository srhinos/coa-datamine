                    <Size x="368" y="38"/>
                    <Anchors>
                        <Anchor point="LEFT" x="24" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="Selected" alphaMode="ADD">
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="Pushed" hidden="true">
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture parentKey="Highlight" alphaMode="ADD">
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                self.Pushed:SetAtlas("pta-tab-pushed", Const.TextureKit.UseAtlasSize)
                self.Normal:SetAtlas("pta-tab-normal", Const.TextureKit.UseAtlasSize)
                self.Highlight:SetAtlas("pta-tab-highlight", Const.TextureKit.UseAtlasSize)
                self.Selected:SetAtlas("pta-tab-checked", Const.TextureKit.UseAtlasSize)
                MixinAndLoadScripts(self, "PathAppendixItemMixin")
            </OnLoad>
        </Scripts>

        <NormalTexture parentKey="Normal">
            <Anchors>
                <Anchor point="CENTER"/>
            </Anchors>
        </NormalTexture>

        <HighlightTexture />
    </Button>
</Ui>