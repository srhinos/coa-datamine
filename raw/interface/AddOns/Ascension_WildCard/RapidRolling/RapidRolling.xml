                    <OnTextChanged>
                        SearchBoxTemplate_OnTextChanged(self)
                        if self:IsVisible() then
                            self:GetParent():UndesiredSearch(self:GetText():trim())
                        end
                    </OnTextChanged>
                    <OnLeave>
                        GameTooltip:Hide()
                    </OnLeave>
                </Scripts>
            </EditBox>

            <Button name="$parentUndesiredFilter" parentKey="UndesiredFilter" inherits="FilterDropDownButtonTemplate" motionScriptsWhileDisabled="true">
                <Size x="86" y="22"/>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentUndesiredSearchBox" relativePoint="RIGHT"/>
                </Anchors>
                <Scripts>
                    <OnLeave>
                        GameTooltip:Hide()
