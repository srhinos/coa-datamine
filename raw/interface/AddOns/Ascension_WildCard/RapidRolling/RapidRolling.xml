                                GameTooltip:SetText(NEXT_TALENT_ROLL_LIMIT:format(nextMaxRoll), 1, 1, 1)
                                GameTooltip:AddLine(NEXT_TALENT_ROLL_LIMIT_TOOLTIP, 1, 0.82, 0, true)
                                GameTooltip:Show()
                            </OnEnter>
                            <OnLeave function="GameTooltip_Hide"/>
