    <AnimationGroup name="RapidRollToastAnimOutTemplate" virtual="true">
        <Alpha parentKey="Alpha" change="-1" startDelay="0.6" duration="0.1" order="1"/>
        <Scripts>
            <OnFinished>
                self:GetParent():Hide()
                self:GetParent():GetParent():OnAnimFinished()
            </OnFinished>
        </Scripts>
    </AnimationGroup>

    <Frame name="RapidRollItemGlowToastTemplate" virtual="true">
        <Anchors>
            <!--<Anchor point="CENTER" x="0" y="0"/>-->
            <Anchor point="TOPLEFT" x="0" y="0"/>
            <Anchor point="BOTTOMRIGHT" x="0" y="0"/>
        </Anchors>

        <Animations>
            <AnimationGroup parentKey="AnimIn" inherits="ToastAnimInTemplate"/>
            <AnimationGroup parentKey="AnimOut" inherits="RapidRollToastAnimOutTemplate"/>
        </Animations>

        <Layers>
            <Layer level="OVERLAY">
                <Texture name="$parentGlow" inherits="ToastGlowTemplate">
                    <Size x="232" y="48"/>
                </Texture>
                <Texture name="$parentShine" inherits="ToastShineTemplate">
                    <Size x="171" y="36"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="-10" y="2"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad>
                self.Glow:SetAtlas("loottoast-glow", Const.TextureKit.IgnoreAtlasSize)
                self.Shine:SetAtlas("loottoast-sheen", Const.TextureKit.IgnoreAtlasSize)

                function self:PlayFadeOut()
                    self.AnimOut:Play()
                end
                
                self:SetFrameLevel(self:GetParent():GetFrameLevel() + 16)
            </OnLoad>
        </Scripts>
    </Frame>

