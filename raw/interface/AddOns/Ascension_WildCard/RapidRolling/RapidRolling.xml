            <Button name="$parentDesiredDeselectAll" parentKey="DesiredDeselectAll" text="DESELECT_ALL" inherits="StandardButtonTemplate">
                <Size x="122" y="22"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeTo="$parentDesiredAbilities" relativePoint="TOPLEFT" x="1" y="0"/>
                </Anchors>

                <Scripts>
                    <OnClick>
                        C_Wildcard.ClearDesiredSpells()
                        local specID = SpecializationUtil.GetActiveSpecialization()
                        if specID and RapidRollDesired[specID] then
                            wipe(RapidRollDesired[specID])
                        end
                    </OnClick>
                </Scripts>
            </Button>

            <Button name="$parentDesiredSelectAll" parentKey="DesiredSelectAll" text="SELECT_ALL" inherits="StandardButtonTemplate">
                <Size x="122" y="22"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeTo="$parentDesiredDeselectAll" relativePoint="BOTTOMRIGHT" x="2"/>
                </Anchors>

                <Scripts>
                    <OnClick>
                        C_Wildcard.AddAllDesiredFilter()
                    </OnClick>
                </Scripts>
            </Button>

            <EditBox name="$parentDesiredSearchBox" parentKey="DesiredSearchBox" inherits="SearchBoxTemplate">
                <Size x="150" y="22"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeTo="$parentDesiredDeselectAll" relativePoint="TOPLEFT" x="9" y="2"/>
                </Anchors>

                <Scripts>
                    <OnTextChanged>
                        SearchBoxTemplate_OnTextChanged(self)
                        if self:IsVisible() then
                            self:GetParent():DesiredSearch(self:GetText():trim())
                        end
                    </OnTextChanged>
                    <OnLeave>
                        GameTooltip:Hide()
                    </OnLeave>
                </Scripts>
            </EditBox>

