                        <Anchors>
                            <Anchor point="TOP" y="-18"/>
                        </Anchors>
                        
                        <Layers>
                            <Layer>
                                <Texture name="$parentDice" parentKey="Dice" file="Interface\WildCard\anim_constant_final_3">
