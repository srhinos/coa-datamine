                </Anchors>
                <Scripts>
                    <OnLeave>
                        GameTooltip:Hide()
                    </OnLeave>
                </Scripts>
            </Button>

            <Button name="$parentUndesiredDeselectAll" parentKey="UndesiredDeselectAll" text="DESELECT_ALL" inherits="StandardButtonTemplate">
                <Size x="247" y="22"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeTo="$parentUndesiredAbilities" relativePoint="TOPLEFT" x="1"/>
                </Anchors>

                <Scripts>
                    <OnClick>
                        C_Wildcard.ClearUndesiredSpells()
                        local specID = SpecializationUtil.GetActiveSpecialization()
                        if specID and RapidRollUndesired[specID] then
                            wipe(RapidRollUndesired[specID])
                        end
                    </OnClick>
                </Scripts>
            </Button>

            <EditBox name="$parentUndesiredSearchBox" parentKey="UndesiredSearchBox" inherits="SearchBoxTemplate">
