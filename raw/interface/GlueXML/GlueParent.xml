<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
	<Script file="GlueParent.lua"/>
	<Frame name="GlueParent" setAllPoints="true">
		<Scripts>
			<!-- Register here for any events you want to monitor globally -->
			<OnLoad>
				UIParent = self
				GlueParent_OnLoad(self);
			</OnLoad>
			<!-- Respond here to any events you want to monitor globally -->
			<OnEvent>
				GlueParent_OnEvent(event, ...);
			</OnEvent>
			<OnUpdate>
				GlueFrameFadeUpdate(elapsed);
			</OnUpdate>
		</Scripts>
		
		<Frames>
			<Frame name="GlueClickBlocker" enableMouse="true" hidden="true" frameLevel="500" frameStrata="HIGH" setAllPoints="true">
				<Layers>
					<Layer level="BACKGROUND">
						<Texture setAllPoints="true">
							<Color r="0" g="0" b="0" a="0.6"/>
						</Texture>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
	</Frame>
</Ui>
