                    </Anchors>
                </FontString>

                <Texture name="$parentExpansion" parentKey="Expansion">
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentName" relativePoint="LEFT"/>
                    </Anchors>
                </Texture>

                <FontString name="$parentCharacters" parentKey="Characters" inherits="GameFontHighlightOutline" justifyH="RIGHT">
                    <Anchors>
                        <Anchor point="RIGHT" x="-8" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad>
                Mixin(self, RealmScrollListItemMixin)
            </OnLoad>
            <OnClick>
                self:OnClick(button)
            </OnClick>
            <OnDoubleClick>
                self:OnDoubleClick()
            </OnDoubleClick>
            <OnEnter>
                self:OnEnter()
            </OnEnter>
            <OnLeave>
                self:OnLeave()
            </OnLeave>
        </Scripts>
    </Button>

