    <Frame name="RealmPageTemplate" virtual="true">
        <Scripts>
            <OnLoad>
                self:GetParent().Pages = self:GetParent().Pages or {}
                tinsert(self:GetParent().Pages, self)
                self:SetSize(GlueParent:GetWidth(), GetScreenHeight())
            </OnLoad>
        </Scripts>
    </Frame>

