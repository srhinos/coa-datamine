    <Button name="RealmScrollListItemTemplate" inherits="ScrollListItemTemplate" virtual="true">
        <Size x="0" y="32"/>

        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentStatusIcon" parentKey="StatusIcon">
                    <Size x="10" y="10"/>
                    <Anchors>
                        <Anchor point="LEFT" x="8" y="0"/>
                    </Anchors>
                </Texture>

                <FontString name="$parentName" parentKey="Name" inherits="GameFontNormalOutline" justifyH="LEFT" maxLines="1">
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentStatusIcon" relativePoint="RIGHT" x="6" y="0"/>
