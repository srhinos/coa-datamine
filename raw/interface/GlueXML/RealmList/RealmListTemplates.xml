    <CheckButton name="RealmTabTemplate" virtual="true">
        <Size x="176" y="42"/>
        
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "RealmTabMixin")
            </OnLoad>
        </Scripts>

        <ButtonText parentKey="Text">
            <Anchors>
                <Anchor point="CENTER"/>
            </Anchors>
        </ButtonText>

        <PushedTextOffset x="0" y="-2"/>

        <NormalFont style="GameFontNormalOutline"/>
        <HighlightFont style="GameFontHighlightOutline"/>
        <DisabledFont style="GameFontHighlightOutline"/>

        <NormalTexture alpha="0.5" setAllPoints="true"/>
        <PushedTexture alpha="0.5" setAllPoints="true"/>
        <HighlightTexture alphaMode="ADD" alpha="0.5" setAllPoints="true"/>
        <CheckedTexture alphaMode="ADD" setAllPoints="true"/>
    </CheckButton>

    <Button name="BaseRealmChoiceTemplate" virtual="true">
        <Size x="330" y="600"/>

        <Layers>
            <Layer level="BORDER">
                <Texture name="$parentBanner" parentKey="Banner" setAllPoints="true"/>
            </Layer>

            <Layer level="BACKGROUND">
                <Texture parentKey="Background">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="12" y="-22"/>
                        <Anchor point="BOTTOMRIGHT"  x="-12" y="72"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="ARTWORK">
                <FontString name="$parentName" parentKey="Name" inherits="RealmTitleFont" text="REALM_NAME">
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="160"/>
                    </Anchors>
                </FontString>

                <Texture name="$parentNameTexture" parentKey="NameTexture">
                    <Size x="256" y="64"/>
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="160"/>
                    </Anchors>
                </Texture>

                <FontString name="$parentSubName" parentKey="SubName" inherits="LargeRealmTitleFont" text="REALM_NAME">
                    <Anchors>
                        <Anchor point="TOP" relativeTo="$parentName" relativePoint="BOTTOM" y="-1"/>
                    </Anchors>
                </FontString>

                <FontString name="$parentNotice" parentKey="Notice" inherits="GameFontHighlightOutline" hidden="true" text="ALPHA_PURCHASE_REQUIRED">
                    <Anchors>
                        <Anchor point="CENTER" relativePoint="TOP" x="0" y="-92"/>
                    </Anchors>
                </FontString>

                <FontString name="$parentStatus" parentKey="Status" inherits="GameFontNormalOutline" text="REALM_IS_S">
                    <Anchors>
                        <Anchor point="TOP" x="0" y="-48"/>
                    </Anchors>
                </FontString>

                <Texture name="$parentStatusIcon" parentKey="StatusIcon" file="Interface\FriendsFrame\StatusIcon-Online">
                    <Size x="8" y="8"/>
                    <Anchors>
                        <Anchor point="RIGHT" relativeTo="$parentStatus" relativePoint="LEFT" x="-2" y="0"/>
                    </Anchors>
                </Texture>
                
                <FontString name="$parentWrongClient" parentKey="WrongClient" inherits="GameFontHighlightOutline" hidden="true" text="DOWNLOAD_PTR_CLIENT">
                    <Anchors>
                        <Anchor point="BOTTOM" y="96"/>
                    </Anchors>
                    <Color r="1" g="0.42" b="0.42"/>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <Button name="$parentSelectButton" parentKey="SelectButton" text="SELECT_REALM" inherits="SharedButtonTemplate">
                <Size x="155" y="38"/>

                <Anchors>
                    <Anchor point="BOTTOM" x="0" y="52"/>
                </Anchors>

                <Scripts>
                    <OnClick>
                        self:GetParent():Select()
                    </OnClick>
                    <OnEnter>
                        if self:IsEnabled() == 1 and self:GetParent():IsEnabled() == 1 then
                            self:GetParent():OnEnter()
                            self:GetParent():LockHighlight()
                        end
                    </OnEnter>
                    <OnLeave>
                        if self:IsEnabled() == 1 and self:GetParent():IsEnabled() == 1 then
                            self:GetParent():OnLeave()
                            self:GetParent():UnlockHighlight()
                        end
                    </OnLeave>
                </Scripts>
            </Button>

            <Frame name="$parentFlashFrame" parentKey="FlashFrame" hidden="true" setAllPoints="true">
                <Layers>
                    <Layer level="OVERLAY">
                        <Texture alphaMode="ADD" setAllPoints="true">
                            <Color r="1" g="1" b="1" a="1"/>
                        </Texture>
                    </Layer>
                </Layers>

                <Animations>
                    <AnimationGroup parentKey="Anim">
                        <Alpha change="0" order="1" duration="0"/>
                        <Alpha change="1" order="2" duration="0.1" smoothing="IN"/>
                        <Alpha change="-1" order="3" duration="0.2" smoothing="IN_OUT"/>

                        <Scripts>
                            <OnPlay>
                                self:GetParent():Show()
                            </OnPlay>
                            <OnStop>
                                self:GetParent():Hide()
                            </OnStop>
                            <OnFinished>
                                self:GetParent():Hide()
                            </OnFinished>
                        </Scripts>
                    </AnimationGroup>
                </Animations>
            </Frame>
        </Frames>

        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "LargeRealmMixin")
            </OnLoad>
        </Scripts>
    </Button>

