    <Frame name="SmallRealmInfoIconTemplate" inherits="RealmInfoScriptsTemplate" virtual="true">
        <Size x="300" y="24"/>

        <Layers>
            <Layer level="BORDER">
                <Texture name="$parentIconBackground" parentKey="IconBackground">
                    <Size x="21" y="21"/>
                    <Anchors>
                        <Anchor point="LEFT"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="ARTWORK">
                <Texture name="$parentIconBorder" parentKey="IconBorder">
                    <Size x="26" y="26"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeTo="$parentIconBackground"/>
                    </Anchors>
                </Texture>

                <FontString name="$parentHeader" parentKey="Header" inherits="GameFontNormalOutlineSmall">
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentIconBackground" relativePoint="RIGHT" x="4" y="6"/>
                    </Anchors>
                </FontString>

                <FontString name="$parentText" parentKey="Text" inherits="GameFontHighlightOutlineSmall">
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentIconBackground" relativePoint="RIGHT" x="4" y="-6"/>
                    </Anchors>
                </FontString>
            </Layer>

            <Layer level="OVERLAY">
                <Texture name="$parentIcon" parentKey="Icon">
                    <Anchors>
                        <Anchor point="CENTER" relativeTo="$parentIconBackground" x="0" y="1"/>
                    </Anchors>
                </Texture>

                <Texture name="$parentBadge" parentKey="Badge">
                    <Anchors>
                        <Anchor point="CENTER" relativeTo="$parentIconBackground" relativePoint="BOTTOM" x="0" y="2"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="HIGHLIGHT">
                <Texture name="$parentIconHighlight" alphaMode="ADD" parentKey="IconHighlight">
                    <Size x="20" y="20"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeTo="$parentIconBackground"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

