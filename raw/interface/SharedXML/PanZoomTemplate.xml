<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="PanZoomTemplate.lua"/>

    <ScrollFrame name="PanZoomTemplate" enableMouse="true" virtual="true">
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "PanZoomMixin")
            </OnLoad>
            <OnMouseWheel>
                self:OnMouseWheel(delta) -- idk why mixin load scripts is not working
            </OnMouseWheel>
        </Scripts>

        <ScrollChild>
            <Frame name="$parentArea" parentKey="Area">
            </Frame>
        </ScrollChild>
    </ScrollFrame>
</Ui>