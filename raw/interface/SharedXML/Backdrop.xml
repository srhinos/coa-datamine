<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="Backdrop.lua"/>

    <Frame name="BackdropTemplate" virtual="true">
        <Scripts>
            <OnLoad>
                Mixin(self, "BackdropTemplateMixin")
                self:OnBackdropLoaded()
            </OnLoad>
            <OnSizeChanged>
                if self.OnBackdropSizeChanged then
                    self:OnBackdropSizeChanged() -- can be called before OnLoad so mixin never loads.
                end
            </OnSizeChanged>
        </Scripts>
    </Frame>
</Ui>