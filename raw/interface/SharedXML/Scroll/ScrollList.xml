    <Button name="MinimalScrollBarStepperScripts" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Texture"/>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad>
                MixinAndLoad(self, MinimalScrollBarStepperScriptsMixin)
            </OnLoad>
            <OnShow>
                self:OnShow()
            </OnShow>
            <OnEnter>
                self:OnEnter()
            </OnEnter>
            <OnLeave>
                self:OnLeave()
            </OnLeave>
            <OnMouseDown>
                self:OnMouseDown()
            </OnMouseDown>
            <OnMouseUp>
                self:OnMouseUp()
            </OnMouseUp>
            <OnEnable>
                self:OnEnable()
            </OnEnable>
            <OnDisable>
                self:OnDisable()
            </OnDisable>
        </Scripts>
    </Button>

    <Button name="ScrollThumbScriptsTemplate" parentKey="Thumb" virtual="true">
        <Anchors>
            <Anchor point="TOP"/>
        </Anchors>

        <Scripts>
            <OnLoad>
                MixinAndLoad(self, MinimalScrollListThumbMixin)
            </OnLoad>
            <OnShow>
                self:OnShow()
            </OnShow>
            <OnEnable>
                self:OnEnable()
            </OnEnable>
            <OnDisable>
                self:OnDisable()
            </OnDisable>
            <OnEnter>
                self:OnEnter()
            </OnEnter>
            <OnLeave>
                self:OnLeave()
            </OnLeave>
            <OnMouseDown>
                self:OnMouseDown()
            </OnMouseDown>
            <OnMouseUp>
                self:OnMouseUp()
            </OnMouseUp>
        </Scripts>
    </Button>

    <Button name="MinimalScrollThumbTemplate" inherits="ScrollThumbScriptsTemplate" virtual="true">
        <Size x="8" y="52"/>

        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentBegin" parentKey="Begin">
                    <Size x="8" y="8"/>

                    <Anchors>
                        <Anchor point="TOP"/>
                    </Anchors>
                </Texture>

                <Texture name="$parentEnd" parentKey="End">
                    <Size x="8" y="36"/>
                    <Anchors>
                        <Anchor point="BOTTOM"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="BORDER">
                <Texture name="$parentMiddle" parentKey="Middle">
                    <Anchors>
                        <Anchor point="TOP" relativeTo="$parentBegin" relativePoint="BOTTOM" y="2"/>
                        <Anchor point="BOTTOM" relativeTo="$parentEnd" relativePoint="TOP" y="-22"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <Attributes>
            <Attribute name="upBeginTexture" value="minimal-scrollbar-thumb-top"/>
            <Attribute name="upMiddleTexture" value="minimal-scrollbar-thumb-middle"/>
            <Attribute name="upEndTexture" value="minimal-scrollbar-thumb-bottom"/>
            <Attribute name="overBeginTexture" value="minimal-scrollbar-thumb-top-over"/>
            <Attribute name="overMiddleTexture" value="minimal-scrollbar-thumb-middle-over"/>
            <Attribute name="overEndTexture" value="minimal-scrollbar-thumb-bottom-over"/>
            <Attribute name="downBeginTexture" value="minimal-scrollbar-thumb-top-down"/>
            <Attribute name="downMiddleTexture" value="minimal-scrollbar-thumb-middle-down"/>
            <Attribute name="downEndTexture" value="minimal-scrollbar-thumb-bottom-down"/>
        </Attributes>
    </Button>

    <Button name="StandardScrollThumbTemplate" parentKey="Thumb" inherits="ScrollThumbScriptsTemplate" virtual="true">
        <Size x="18" y="47"/>

        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentBegin" parentKey="Begin">
                    <Size x="18" y="21"/>

                    <Anchors>
                        <Anchor point="TOP" x="1" y="-1"/>
                    </Anchors>
                </Texture>

                <Texture name="$parentEnd" parentKey="End">
                    <Size x="18" y="21"/>
                    <Anchors>
                        <Anchor point="BOTTOM" x="1" y="-1"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="BORDER">
                <Texture name="$parentMiddle" parentKey="Middle">
                    <Anchors>
                        <Anchor point="TOP" relativeTo="$parentBegin" relativePoint="BOTTOM" y="8"/>
                        <Anchor point="BOTTOM" relativeTo="$parentEnd" relativePoint="TOP" y="-8"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <Attributes>
            <Attribute name="upBeginTexture" value="ui-scrollbar-knob-endcap-top"/>
            <Attribute name="upMiddleTexture" value="ui-scrollbar-knob-center"/>
            <Attribute name="upEndTexture" value="ui-scrollbar-knob-endcap-bottom"/>
            <Attribute name="overBeginTexture" value="ui-scrollbar-knob-mouseover-endcap-top"/>
            <Attribute name="overMiddleTexture" value="ui-scrollbar-knob-mouseover-center"/>
            <Attribute name="overEndTexture" value="ui-scrollbar-knob-mouseover-endcap-bottom"/>
            <Attribute name="downBeginTexture" value="ui-scrollbar-knob-endcap-top-disabled"/>
            <Attribute name="downMiddleTexture" value="ui-scrollbar-knob-center-disabled"/>
            <Attribute name="downEndTexture" value="ui-scrollbar-knob-endcap-bottom-disabled"/>
        </Attributes>
