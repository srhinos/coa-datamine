    <Button name="ScrollListItemBaseTemplate" virtual="true">
        <Anchors>
            <Anchor point="LEFT"/>
            <Anchor point="RIGHT"/>
        </Anchors>
        <Scripts>
            <OnLoad>
                Mixin(self, ScrollListItemBaseMixin)
            </OnLoad>
            <OnClick>
                self:OnClick(button)
            </OnClick>
            <OnEnter>
                self:OnEnter()
            </OnEnter>
            <OnLeave>
                self:OnLeave()
            </OnLeave>
        </Scripts>
    </Button>
    
    <Button name="ScrollListItemTemplate" inherits="ScrollListItemBaseTemplate" virtual="true">
        <Size x="0" y="20"/>

        <NormalTexture setAllPoints="true" file="Interface\GuildFrame\GuildFrame">
            <TexCoords left="0.36230469" right="0.38183594" top="0.95898438" bottom="0.99804688"/>
        </NormalTexture>
        <HighlightTexture parentKey="HighlightTexture" file="Interface\FriendsFrame\UI-FriendsFrame-HighlightBar" alphaMode="ADD" setAllPoints="true"/>
    </Button>

    <Button name="ScrollListItemTextTemplate" inherits="ScrollListItemTemplate" virtual="true">
        <ButtonText name="$parentText" parentKey="Text" inherits="GameFontNormal" justifyH="LEFT" maxLines="1">
            <Anchors>
                <Anchor point="LEFT" x="4" y="0"/>
                <Anchor point="RIGHT" x="-4" y="0"/>
            </Anchors>
        </ButtonText>
    </Button>

    <Frame name="ScrollListTemplateNoScrollBar" virtual="true">
        <Frames>
            <ScrollFrame name="$parentScrollFrame" parentKey="ScrollFrame" inherits="HybridScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="4" y="-7"/>
                    <Anchor point="BOTTOMRIGHT" x="-4" y="3"/>
                </Anchors>

                <Frames>
                    <Frame name="$parentArtOverlay" parentKey="ArtOverlay" setAllPoints="true">
                        <Layers>
                            <Layer level="OVERLAY">
                                <Texture parentKey="SelectedHighlight" hidden="true">
                                    <Color r="1" g="0.8" b="0.2" a="0.2"/>
                                </Texture>
                            </Layer>
                        </Layers>
                    </Frame>

                    <Slider name="$parentScrollBar" parentKey="scrollBar" inherits="MinimalHybridScrollBarTemplate">
                    </Slider>
                </Frames>
            </ScrollFrame>

            <Frame name="$parentInsetFrame" parentKey="InsetFrame" inherits="InsetFrameTemplate2">
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$parentScrollFrame" relativePoint="BOTTOMRIGHT"/>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        UseParentLevel(self)
                        MixinAndLoadScripts(self, "NineSlicePanelMixin")
                    </OnLoad>
                </Scripts>
            </Frame>
        </Frames>

        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, ScrollListMixin)
            </OnLoad>
        </Scripts>
    </Frame>

    <Frame name="ScrollListTemplate" virtual="true">
        <Frames>
            <ScrollFrame name="$parentScrollFrame" parentKey="ScrollFrame" inherits="HybridScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="4" y="-7"/>
                    <Anchor point="BOTTOMRIGHT" x="-28" y="3"/>
                </Anchors>

                <Frames>
                    <Frame name="$parentArtOverlay" parentKey="ArtOverlay" setAllPoints="true">
                        <Layers>
                            <Layer level="OVERLAY">
                                <Texture parentKey="SelectedHighlight" hidden="true">
                                    <Color r="1" g="0.8" b="0.2" a="0.2"/>
                                </Texture>
                            </Layer>
                        </Layers>
                    </Frame>

                    <Slider name="$parentScrollBar" parentKey="scrollBar" inherits="HybridScrollBarTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT" relativePoint="TOPRIGHT" x="4" y="-10"/>
                            <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT" x="4" y="12"/>
                        </Anchors>

                        <Layers>
                            <Layer level="BACKGROUND">
                                <Texture parentKey="Background" file="Interface\FrameGeneral\UI-Background-Marble" horizTile="true" vertTile="true" setAllPoints="true"/>
                            </Layer>
                        </Layers>
                    </Slider>
                </Frames>
            </ScrollFrame>

            <Frame name="$parentInsetFrame" parentKey="InsetFrame" inherits="InsetFrameTemplate2">
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$parentScrollFrame" relativePoint="BOTTOMRIGHT"/>
