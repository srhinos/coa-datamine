<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="ScrollFrame.lua"/>
    <Texture name="UIPanelScrollBarButton" virtual="true">
        <TexCoords left="0.20" right="0.80" top="0.25" bottom="0.75"/>
    </Texture>
    <Button name="UIPanelScrollUpButtonTemplate" virtual="true">
        <Size>
            <AbsDimension x="18" y="16"/>
        </Size>
        <NormalTexture inherits="UIPanelScrollBarButton" parentKey="Normal" file="Interface\Buttons\UI-ScrollBar-ScrollUpButton-Up"/>
        <PushedTexture inherits="UIPanelScrollBarButton" parentKey="Pushed" file="Interface\Buttons\UI-ScrollBar-ScrollUpButton-Down"/>
        <DisabledTexture inherits="UIPanelScrollBarButton" parentKey="Disabled" file="Interface\Buttons\UI-ScrollBar-ScrollUpButton-Disabled"/>
        <HighlightTexture inherits="UIPanelScrollBarButton" parentKey="Highlight" file="Interface\Buttons\UI-ScrollBar-ScrollUpButton-Highlight" alphaMode="ADD"/>
    </Button>
    <Button name="UIPanelScrollDownButtonTemplate" virtual="true">
        <Size>
            <AbsDimension x="18" y="16"/>
        </Size>
        <NormalTexture inherits="UIPanelScrollBarButton" parentKey="Normal" file="Interface\Buttons\UI-ScrollBar-ScrollDownButton-Up"/>
        <PushedTexture inherits="UIPanelScrollBarButton" parentKey="Pushed" file="Interface\Buttons\UI-ScrollBar-ScrollDownButton-Down"/>
        <DisabledTexture inherits="UIPanelScrollBarButton" parentKey="Disabled" file="Interface\Buttons\UI-ScrollBar-ScrollDownButton-Disabled"/>
        <HighlightTexture inherits="UIPanelScrollBarButton" parentKey="Highlight" file="Interface\Buttons\UI-ScrollBar-ScrollDownButton-Highlight" alphaMode="ADD"/>
    </Button>
    <Slider name="UIPanelScrollBarTemplate" virtual="true">
        <Size>
            <AbsDimension x="16" y="0"/>
        </Size>
        <Frames>
            <Button name="$parentScrollUpButton" parentKey="ScrollUpButton" inherits="UIPanelScrollUpButtonTemplate">
                <Anchors>
                    <Anchor point="BOTTOM" relativePoint="TOP"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        local parent = self:GetParent();
                        parent:SetValue(parent:GetValue() - (parent:GetHeight() / 2));
                        PlaySound("UChatScrollButton");
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="$parentScrollDownButton" parentKey="ScrollDownButton" inherits="UIPanelScrollDownButtonTemplate">
                <Anchors>
                    <Anchor point="TOP" relativePoint="BOTTOM"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        local parent = self:GetParent();
                        parent:SetValue(parent:GetValue() + (parent:GetHeight() / 2));
                        PlaySound("UChatScrollButton");
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnValueChanged>
                self:GetParent():SetVerticalScroll(value);
            </OnValueChanged>
        </Scripts>
        <ThumbTexture name="$parentThumbTexture" parentKey="ThumbTexture" inherits="UIPanelScrollBarButton" file="Interface\Buttons\UI-ScrollBar-Knob">
            <Size>
                <AbsDimension x="18" y="24"/>
            </Size>
            <TexCoords left="0.20" right="0.80" top="0.125" bottom="0.875"/>
        </ThumbTexture>
    </Slider>
    <Slider name="UIPanelScrollBarTemplateLightBorder" virtual="true">
        <Size>
            <AbsDimension x="16" y="0"/>
        </Size>
        <Frames>
            <Button name="$parentScrollUpButton" inherits="UIPanelScrollUpButtonTemplate">
                <Anchors>
                    <Anchor point="BOTTOM" relativePoint="TOP"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        local parent = self:GetParent();
                        parent:SetValue(parent:GetValue() - (parent:GetHeight() / 2));
                        PlaySound("UChatScrollButton");
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="$parentScrollDownButton" inherits="UIPanelScrollDownButtonTemplate">
                <Anchors>
                    <Anchor point="TOP" relativePoint="BOTTOM"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        local parent = self:GetParent();
                        parent:SetValue(parent:GetValue() + (parent:GetHeight() / 2));
                        PlaySound("UChatScrollButton");
                    </OnClick>
                </Scripts>
            </Button>
            <Frame name="$parentBorder">
                <Size>
                    <AbsDimension x="24" y="0"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentScrollUpButton">
                        <Offset x="-5" y="5"/>
                    </Anchor>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$parentScrollDownButton">
                        <Offset x="5" y="-3"/>
                    </Anchor>
                </Anchors>
                <Backdrop edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
                    <EdgeSize>
                        <AbsValue val="12"/>
                    </EdgeSize>
                    <TileSize>
                        <AbsValue val="16"/>
                    </TileSize>
                    <BackgroundInsets>
                        <AbsInset left="0" right="0" top="5" bottom="5"/>
                    </BackgroundInsets>
                </Backdrop>
                <Scripts>
                    <OnLoad>
                        self:SetBackdropBorderColor(TOOLTIP_DEFAULT_COLOR.r, TOOLTIP_DEFAULT_COLOR.g, TOOLTIP_DEFAULT_COLOR.b, 0.5);
                    </OnLoad>
                </Scripts>
            </Frame>
        </Frames>
        <Scripts>
            <OnValueChanged>
                self:GetParent():SetVerticalScroll(value);
            </OnValueChanged>
        </Scripts>
        <ThumbTexture name="$parentThumbTexture" inherits="UIPanelScrollBarButton" file="Interface\Buttons\UI-ScrollBar-Knob">
            <Size>
                <AbsDimension x="16" y="24"/>
            </Size>
            <TexCoords left="0.25" right="0.75" top="0.125" bottom="0.875"/>
        </ThumbTexture>
    </Slider>
    
    <ScrollFrame name="ScrollFrameScriptsTemplate" virtual="true">
        <Scripts>
            <OnLoad function="ScrollFrame_OnLoad"/>
            <OnScrollRangeChanged function="ScrollFrame_OnScrollRangeChanged"/>
            <!--  The code to disable the ScrollDownButton is pretty hacked, but it works -->
            <OnVerticalScroll function="ScrollFrame_OnVerticalScroll"/>
            <OnMouseWheel function="ScrollFrameTemplate_OnMouseWheel"/>
        </Scripts>
    </ScrollFrame>
    
    <ScrollFrame name="UIPanelScrollFrameTemplate" inherits="ScrollFrameScriptsTemplate" virtual="true">
        <Frames>
            <Slider name="$parentScrollBar" parentKey="ScrollBar" inherits="UIPanelScrollBarTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="6" y="-16"/>
                        </Offset>
                    </Anchor>
                    <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT">
                        <Offset>
                            <AbsDimension x="6" y="16"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Slider>
        </Frames>
    </ScrollFrame>
    <ScrollFrame name="UIPanelScrollFrameTemplate2" inherits="UIPanelScrollFrameTemplate" virtual="true">
        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentTop" file="Interface\PaperDollInfoFrame\UI-Character-ScrollBar">
                    <Size>
                        <AbsDimension x="31" y="256"/>
                    </Size>
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                    </Anchors>
                    <TexCoords left="0" right="0.484375" top="0" bottom="1.0"/>
                </Texture>
                <Texture name="$parentBottom" file="Interface\PaperDollInfoFrame\UI-Character-ScrollBar">
                    <Size>
                        <AbsDimension x="31" y="106"/>
                    </Size>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT"/>
                    </Anchors>
                    <TexCoords left="0.515625" right="1.0" top="0" bottom="0.4140625"/>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                ScrollFrame_OnLoad(self);
                _G[self:GetName().."Top"]:SetPoint("TOPLEFT", _G[self:GetName().."ScrollBar".."ScrollUpButton"], "TOPLEFT", -8, 5);
                _G[self:GetName().."Bottom"]:SetPoint("BOTTOMLEFT", _G[self:GetName().."ScrollBar".."ScrollDownButton"], "BOTTOMLEFT", -8, -2);
            </OnLoad>
        </Scripts>
    </ScrollFrame>
    <ScrollFrame name="FauxScrollFrameTemplate" inherits="UIPanelScrollFrameTemplate" virtual="true">
        <Scripts>
            <OnScrollRangeChanged function=""/>
        </Scripts>
        <ScrollChild>
            <Frame name="$parentScrollChildFrame" parentKey="ScrollChildFrame">
                <Size>
                    <AbsDimension x="300" y="334"/>
                </Size>
            </Frame>
        </ScrollChild>
    </ScrollFrame>
    <ScrollFrame name="FauxScrollFrameTemplateLight" virtual="true">
        <Frames>
            <Slider name="$parentScrollBar" inherits="UIPanelScrollBarTemplateLightBorder">
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="6" y="-16"/>
                        </Offset>
                    </Anchor>
                    <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT">
                        <Offset>
                            <AbsDimension x="6" y="16"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Slider>
        </Frames>
        <Scripts>
            <OnLoad function="ScrollFrame_OnLoad"/>
            <OnScrollRangeChanged function=""/>
            <OnVerticalScroll function="ScrollFrame_OnVerticalScroll"/>
            <OnMouseWheel function="ScrollFrameTemplate_OnMouseWheel"/>
        </Scripts>
        <ScrollChild>
            <Frame name="$parentScrollChildFrame">
                <Size>
                    <AbsDimension x="300" y="334"/>
                </Size>
            </Frame>
        </ScrollChild>
    </ScrollFrame>

    <ScrollFrame name="StandardProportionalScrollFrameTemplate" inherits="ScrollFrameScriptsTemplate" virtual="true">
        <Frames>
            <Button name="$parentScrollBar" parentKey="ScrollBar" inherits="StandardProportionalScrollListBarTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPRIGHT" y="-20"/>
                    <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT" y="20"/>
                </Anchors>
                
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="2" y="-0"/>
                                <Anchor point="BOTTOMRIGHT" x="-2" y="0"/>
                            </Anchors>
                            <Color r="0.09" g="0.09" b="0.09" a="0.7"/>
                        </Texture>
                    </Layer>
                </Layers>
                
                <Frames>
                    <Button name="$parentScrollUpButton" parentKey="scrollUp" inherits="MinimalScrollBarStepperScripts">
                        <Size x="18" y="16"/>

                        <Anchors>
                            <Anchor point="BOTTOM" relativePoint="TOP" x="0" y="1"/>
                        </Anchors>

                        <Scripts>
                            <OnClick>
                                local parent = self:GetParent()
                                parent:SetValue(parent:GetValue() - (parent:GetHeight() / 2));
                                PlaySound("UChatScrollButton");
                            </OnClick>
                        </Scripts>

                        <Attributes>
                            <Attribute name="direction" value="1" type="number"/>
                            <Attribute name="normalTexture" value="ui-scrollbar-scrollupbutton-up"/>
                            <Attribute name="overTexture" value="ui-scrollbar-scrollupbutton-highlight"/>
                            <Attribute name="downTexture" value="ui-scrollbar-scrollupbutton-down"/>
                        </Attributes>
                    </Button>

                    <Button name="$parentScrollDownButton" parentKey="scrollDown" inherits="MinimalScrollBarStepperScripts">
                        <Size x="18" y="16"/>

                        <Anchors>
                            <Anchor point="TOP" relativePoint="BOTTOM" x="0" y="-3"/>
                        </Anchors>

                        <Scripts>
                            <OnClick>
                                local parent = self:GetParent()
                                parent:SetValue(parent:GetValue() + (parent:GetHeight() / 2));
                                PlaySound("UChatScrollButton");
                            </OnClick>
                        </Scripts>

                        <Attributes>
                            <Attribute name="direction" value="-1" type="number"/>
                            <Attribute name="normalTexture" value="ui-scrollbar-scrolldownbutton-up"/>
                            <Attribute name="overTexture" value="ui-scrollbar-scrolldownbutton-highlight"/>
                            <Attribute name="downTexture" value="ui-scrollbar-scrolldownbutton-down"/>
                        </Attributes>
                    </Button>
                </Frames>
            </Button>
        </Frames>
    </ScrollFrame>

    <ScrollFrame name="StandardScrollFrameTemplate" inherits="ScrollFrameScriptsTemplate" virtual="true">
        <Frames>
            <Button name="$parentScrollBar" parentKey="ScrollBar" inherits="StandardScrollListBarTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPRIGHT" y="-20"/>
                    <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT" y="20"/>
                </Anchors>

                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="2" y="-0"/>
                                <Anchor point="BOTTOMRIGHT" x="-2" y="0"/>
                            </Anchors>
                            <Color r="0.09" g="0.09" b="0.09" a="0.7"/>
                        </Texture>
                    </Layer>
                </Layers>

                <Frames>
                    <Button name="$parentScrollUpButton" parentKey="scrollUp" inherits="MinimalScrollBarStepperScripts">
                        <Size x="18" y="16"/>

                        <Anchors>
                            <Anchor point="BOTTOM" relativePoint="TOP" x="0" y="1"/>
                        </Anchors>

                        <Scripts>
                            <OnClick>
                                local parent = self:GetParent()
                                parent:SetValue(parent:GetValue() - (parent:GetHeight() / 2));
                                PlaySound("UChatScrollButton");
                            </OnClick>
                        </Scripts>

                        <Attributes>
                            <Attribute name="direction" value="1" type="number"/>
                            <Attribute name="normalTexture" value="ui-scrollbar-scrollupbutton-up"/>
                            <Attribute name="overTexture" value="ui-scrollbar-scrollupbutton-highlight"/>
                            <Attribute name="downTexture" value="ui-scrollbar-scrollupbutton-down"/>
                        </Attributes>
                    </Button>

                    <Button name="$parentScrollDownButton" parentKey="scrollDown" inherits="MinimalScrollBarStepperScripts">
                        <Size x="18" y="16"/>

                        <Anchors>
                            <Anchor point="TOP" relativePoint="BOTTOM" x="0" y="-3"/>
                        </Anchors>

                        <Scripts>
                            <OnClick>
                                local parent = self:GetParent()
                                parent:SetValue(parent:GetValue() + (parent:GetHeight() / 2));
                                PlaySound("UChatScrollButton");
                            </OnClick>
                        </Scripts>

                        <Attributes>
                            <Attribute name="direction" value="-1" type="number"/>
                            <Attribute name="normalTexture" value="ui-scrollbar-scrolldownbutton-up"/>
                            <Attribute name="overTexture" value="ui-scrollbar-scrolldownbutton-highlight"/>
                            <Attribute name="downTexture" value="ui-scrollbar-scrolldownbutton-down"/>
                        </Attributes>
                    </Button>
                </Frames>
            </Button>
        </Frames>
    </ScrollFrame>
</Ui>