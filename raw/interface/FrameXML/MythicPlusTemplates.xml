<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="MythicPlusTemplates.lua"/>

    <Button name="KeystoneAffixTemplate" virtual="true">
        <Size x="56" y="56"/>

        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" setAllPoints="true"/>
            </Layer>

            <Layer level="BORDER">
                <Texture parentKey="Icon" setAllPoints="true" hidden="true"/>
            </Layer>

            <Layer level="ARTWORK">
                <Texture parentKey="Border">
                    <Size x="58" y="58"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="HIGHLIGHT">
                <Texture file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight" alphaMode="ADD">
                    <Size x="68" y="68"/>
                    <Anchors>
                        <Anchor point="CENTER" y="-2"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <Frames>
            <Frame name="$parentInformation" parentKey="Information" hidden="true">
                <Size x="108" y="108"/>

                <Anchors>
                    <Anchor point="CENTER"/>
                </Anchors>

                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentShadow" parentKey="Shadow">
                            <Size x="128" y="64"/>
                            <Anchors>
                                <Anchor point="BOTTOM" y="-6"/>
                            </Anchors>
                        </Texture>
                    </Layer>

                    <Layer>
                        <FontString parentKey="Text" inherits="GameFontNormalLarge">
                            <Size x="128" y="64"/>
                            <Anchors>
                                <Anchor point="CENTER" relativeTo="$parentShadow" y="-2"/>
                            </Anchors>
                            <Color r="1" g="0.82" b="0"/>
                        </FontString>
                    </Layer>
                </Layers>

                <Scripts>
                    <OnLoad>
                        self.Shadow:SetAtlas("common-shadow-circle", Const.TextureKit.IgnoreAtlasSize)
                    </OnLoad>
                </Scripts>
            </Frame>
        </Frames>

        <Scripts>
            <OnLoad>
                self.Border:SetAtlas("ChallengeMode-AffixRing-Lg", Const.TextureKit.IgnoreAtlasSize)
                MixinAndLoad(self, KeystoneAffixMixin)
            </OnLoad>
            <OnEnter>
                self:OnEnter()
            </OnEnter>
            <OnLeave>
                GameTooltip:Hide()
            </OnLeave>
            <OnClick>
                self:OnClick()
            </OnClick>
        </Scripts>
    </Button>

    <Button name="KeystoneAffixSmallTemplate" virtual="true">
        <Size x="18" y="18"/>

        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" setAllPoints="true"/>
            </Layer>

            <Layer level="BORDER">
                <Texture parentKey="Icon" setAllPoints="true" hidden="true"/>
            </Layer>

            <Layer level="ARTWORK">
                <Texture parentKey="Border">
                    <Size x="20" y="20"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="HIGHLIGHT">
                <Texture file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight" alphaMode="ADD">
                    <Size x="24" y="24"/>
                    <Anchors>
                        <Anchor point="CENTER" y="0"/>
                    </Anchors>
                </Texture>

                <FontString parentKey="Level" inherits="PTFontHighlight" text="15">
                    <Size x="28" y="20"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad>
                self.Border:SetAtlas("ChallengeMode-AffixRing-Sm", Const.TextureKit.IgnoreAtlasSize)
                MixinAndLoad(self, KeystoneAffixSmallMixin)
            </OnLoad>
            <OnEnter>
                self:OnEnter()
            </OnEnter>
            <OnLeave>
                GameTooltip:Hide()
            </OnLeave>
            <OnClick>
                self:OnClick()
            </OnClick>
        </Scripts>
    </Button>
</Ui>