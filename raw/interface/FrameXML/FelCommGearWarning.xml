<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="FelCommGearWarning.lua"/>

    <Frame name="DurabilityManIconTemplate" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentIcon" parentKey="Icon">
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="BORDER">
                <Texture name="$parentPulse" parentKey="Pulse" hidden="true">
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>

                    <Animations>
                        <AnimationGroup parentKey="LoopingAnim" looping="REPEAT">
                            <Alpha order="1" duration="0" change="-1"/>
                            <Alpha order="1" duration="0.1" change="1"/>
                            <Scale order="2" duration="1.4" scaleX="1.6" scaleY="1.6" smoothing="OUT"/>
                            <Alpha order="2" duration="1.4" change="-1" smoothing="OUT"/>
                        </AnimationGroup>

                        <AnimationGroup parentKey="Anim">
                            <Alpha order="1" duration="0" change="-1"/>
                            <Alpha order="1" duration="0.1" change="1"/>
                            <Scale order="2" duration="1.4" scaleX="1.6" scaleY="1.6" smoothing="OUT"/>
                            <Alpha order="2" duration="1.4" change="-1" smoothing="OUT"/>
                            <Scripts>
                                <OnFinished>
                                    self:GetParent():Hide()
                                </OnFinished>
                                <OnStop>
                                    self:GetParent():Hide()
                                </OnStop>
                            </Scripts>
                        </AnimationGroup>
                    </Animations>
                </Texture>
            </Layer>
        </Layers>
        
        <Scripts>
            <OnLoad>
                MixinAndLoad(self, DurabilityManIconMixin)
            </OnLoad>
        </Scripts>
    </Frame>

    <Frame name="DurabilityManTemplate" virtual="true">
        <Size x="90" y="110"/>
        
        <Frames>
            <Frame name="$parentHead" parentKey="Head" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="TOP"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-head"/>
                    <Attribute name="slot" value="INVSLOT_HEAD"/>
                </Attributes>
            </Frame>

            <Frame name="$parentShoulderL" parentKey="ShoulderL" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeTo="$parentHead" relativePoint="BOTTOM" x="-2" y="12"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-shoulder-l"/>
                    <Attribute name="slot" value="INVSLOT_SHOULDER"/>
                </Attributes>
            </Frame>

            <Frame name="$parentShoulderR" parentKey="ShoulderR" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentHead" relativePoint="BOTTOM" x="2" y="12"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-shoulder-r"/>
                    <Attribute name="slot" value="INVSLOT_SHOULDER"/>
                </Attributes>
            </Frame>

            <Frame name="$parentChest" parentKey="Chest" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentShoulderL" relativePoint="BOTTOMRIGHT" x="2" y="14"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-chest"/>
                    <Attribute name="slot" value="INVSLOT_CHEST"/>
                </Attributes>
            </Frame>

            <Frame name="$parentWristL" parentKey="WristL" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentShoulderL" relativePoint="BOTTOM" x="-2" y="0"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-wrist-l"/>
                    <Attribute name="slot" value="INVSLOT_WRIST"/>
                </Attributes>
            </Frame>

            <Frame name="$parentWristR" parentKey="WristR" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentShoulderR" relativePoint="BOTTOM" x="2" y="0"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-wrist-r"/>
                    <Attribute name="slot" value="INVSLOT_WRIST"/>
                </Attributes>
            </Frame>

            <Frame name="$parentHandL" parentKey="HandL" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentWristL" relativePoint="BOTTOM" x="0" y="5"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-hand-l"/>
                    <Attribute name="slot" value="INVSLOT_HAND"/>
                </Attributes>
            </Frame>

            <Frame name="$parentHandR" parentKey="HandR" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentWristR" relativePoint="BOTTOM" x="0" y="5"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-hand-r"/>
                    <Attribute name="slot" value="INVSLOT_HAND"/>
                </Attributes>
            </Frame>

            <Frame name="$parentWaist" parentKey="Waist" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentChest" relativePoint="BOTTOM" x="0" y="2"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-waist"/>
                    <Attribute name="slot" value="INVSLOT_WAIST"/>
                </Attributes>
            </Frame>

            <Frame name="$parentLegs" parentKey="Legs" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentWaist" relativePoint="BOTTOM" x="0" y="0"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-legs"/>
                    <Attribute name="slot" value="INVSLOT_LEGS"/>
                </Attributes>
            </Frame>

            <Frame name="$parentFeet" parentKey="Feet" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentLegs" relativePoint="BOTTOM" x="0" y="2"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-feet"/>
                    <Attribute name="slot" value="INVSLOT_FEET"/>
                </Attributes>
            </Frame>

            <Frame name="$parentWeapon" parentKey="Weapon" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="RIGHT" relativeTo="$parentWristL" relativePoint="LEFT" x="0" y="0"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-weapon"/>
                    <Attribute name="slot" value="INVSLOT_MAINHAND"/>
                </Attributes>
            </Frame>

            <Frame name="$parentShield" parentKey="Shield" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentWristR" relativePoint="RIGHT" x="0" y="0"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-shield"/>
                    <Attribute name="slot" value="INVSLOT_OFFHAND"/>
                </Attributes>
            </Frame>

            <Frame name="$parentOffHandWeapon" parentKey="OffHandWeapon" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentWristR" relativePoint="RIGHT" x="0" y="0"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-weapon"/>
                    <Attribute name="slot" value="INVSLOT_OFFHAND"/>
                </Attributes>
            </Frame>

            <Frame name="$parentRanged" parentKey="Ranged" inherits="DurabilityManIconTemplate">
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentShield" relativePoint="BOTTOM" x="0" y="0"/>
                </Anchors>

                <Attributes>
                    <Attribute name="atlas" value="durability-icons-ranged"/>
                    <Attribute name="slot" value="INVSLOT_RANGED"/>
                </Attributes>
            </Frame>
        </Frames>
        
        <Scripts>
            <OnLoad>
                MixinAndLoad(self, DurabilityManMixin)
            </OnLoad>
        </Scripts>
    </Frame>
    
    <Button name="FelCommGearWarningFrame" parent="UIParent" movable="true" clampedToScreen="true" frameStrata="LOW" hidden="true"  inherits="DurabilityManTemplate">
        <Anchors>
            <Anchor point="RIGHT" x="-320" y="180"/>
        </Anchors>
        
        <Frames>
            <Frame name="$parentDropDown" parentKey="DropDown" inherits="UIDropDownMenuTemplate"/>
        </Frames>
        
        <Scripts>
            <OnLoad>
                self:SetUserPlaced(false)
                MixinAndLoad(self, FelCommGearWarningMixin)
            </OnLoad>
            <OnShow>
                self:OnShow()
            </OnShow>
            <OnHide>
                self:OnHide()
            </OnHide>
            <OnEvent>
                self:OnEvent(event, ...)
            </OnEvent>
            <OnEnter>
                self:OnEnter()
            </OnEnter>
            <OnLeave>
                self:OnLeave()
            </OnLeave>
            <OnClick>
                self:OnClick()
            </OnClick>
            <OnDragStart>
                self:StartMoving()
            </OnDragStart>
            <OnDragStop>
                self:StopMovingOrSizing()
            </OnDragStop>
        </Scripts>
    </Button>
</Ui>