<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="ToastMixin.lua"/>

    <AnimationGroup name="ToastAnimInTemplate" virtual="true">
        <Alpha change="-1" duration="0" order="1"/>
        <Alpha change="1" duration="0.2" order="2"/>

        <Scripts>
            <OnFinished>
                local parent = self:GetParent()
                if parent.Glow then
                    parent.Glow.AnimIn:Play()
                end
                if parent.Shine then
                    parent.Shine.AnimIn:Play()
                end
                self:GetParent():PlayFadeOut()
            </OnFinished>
        </Scripts>
    </AnimationGroup>
    <AnimationGroup name="ToastAnimOutTemplate" virtual="true">
        <Alpha parentKey="Alpha" change="-1" startDelay="1.25" duration="0.75" order="1"/>
        <Scripts>
            <OnFinished>
                self:GetParent():Hide()
            </OnFinished>
        </Scripts>
    </AnimationGroup>

    <Texture name="ToastGlowTemplate" parentKey="Glow" alphaMode="ADD" hidden="true" virtual="true">
        <Size x="286" y="109"/>
        <Anchors>
            <Anchor point="CENTER" x="0" y="0"/>
        </Anchors>
        <Animations>
            <AnimationGroup parentKey="AnimIn">
                <Alpha change="-1" duration="0" order="1"/>
                <Alpha change="1" duration="0.2" order="2"/>
                <Alpha change="-1" duration="0.5" order="3"/>
                <Scripts>
                    <OnPlay>
                        self:GetParent():Show()
                    </OnPlay>
                    <OnFinished>
                        self:GetParent():Hide()
                    </OnFinished>
                </Scripts>
            </AnimationGroup>
        </Animations>
    </Texture>
    <Texture name="ToastShineTemplate" parentKey="Shine" alphaMode="ADD" hidden="true" virtual="true">
        <Size x="171" y="75"/>
        <Anchors>
            <Anchor point="BOTTOMLEFT" x="-10" y="12"/>
        </Anchors>
        <Animations>
            <AnimationGroup parentKey="AnimIn">
                <Alpha change="-1" duration="0" order="1"/>
                <Alpha change="1" duration="0.1" order="2"/>
                <Translation offsetX="200" offsetY="0" duration="0.71" order="3"/>
                <Alpha change="-1" duration="0.25" startDelay="0.175" order="3"/>
                <Scripts>
                    <OnPlay>
                        self:GetParent():Show()
                    </OnPlay>
                    <OnFinished>
                        self:GetParent():Hide()
                    </OnFinished>
                </Scripts>
            </AnimationGroup>
        </Animations>
    </Texture>
    <FontString name="ToastItemCountTemplate" inherits="GameFontHighlight" justifyH="RIGHT" virtual="true">
        <Animations>
            <AnimationGroup parentKey="ChangedAnim">
                <Alpha change="-1" duration="0" order="1"/>
                <Alpha change="1" duration="0.1" order="2"/>
            </AnimationGroup>
        </Animations>
    </FontString>
    
