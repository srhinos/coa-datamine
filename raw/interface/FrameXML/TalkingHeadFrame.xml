<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    
    <Script file="TalkingHeadFrame.lua"/>

    <Button name="TalkingHeadFrame" toplevel="true" parent="UIParent" hidden="true" frameStrata="FULLSCREEN_DIALOG">
        <Size x="570" y="155"/>
        <Anchors>
            <Anchor point="BOTTOM" x="0" y="108"/>
        </Anchors>
        
        <Frames>
            <Frame name="$parentPortraitFrame" parentKey="PortraitFrame" setAllPoints="true">
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentBackground" parentKey="Background">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="21" y="-21"/>
                            </Anchors>
                        </Texture>
                    </Layer>

                    <Layer level="OVERLAY">
                        <Texture name="$parentPortrait" parentKey="Portrait">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="5" y="-6"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                    
                    <Layer>
                        <Texture name="$parentIcon" hidden="true" parentKey="Icon">
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeTo="$parentBackground" x="-6" y="6"/>
                                <Anchor point="BOTTOMRIGHT" relativeTo="$parentBackground" x="4" y="-4"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                
                <Frames>
                    <DressUpModel name="$parentModel" parentKey="Model">
                        <Size x="115" y="115"/>

                        <Anchors>
                            <Anchor point="TOPLEFT" x="21" y="-21"/>
                        </Anchors>

                        <Scripts>
                            <OnLoad>
                                self:RegisterEvent("UI_SCALE_CHANGED")
                                self:RegisterEvent("DISPLAY_SIZE_CHANGED")
                            </OnLoad>
                            <OnEvent>
                                self:RefreshUnit()
                            </OnEvent>
                            <OnUpdate>
                                self:SetCamera(0)
                            </OnUpdate>
                        </Scripts>
                    </DressUpModel>
                </Frames>
                
                <Scripts>
                    <OnLoad>
                        self.Portrait:SetAtlas("TalkingHeads-Neutral-PortraitFrame", Const.TextureKit.UseAtlasSize)
                        self.Background:SetAtlas("TalkingHeads-PortraitBg", Const.TextureKit.UseAtlasSize)
                    </OnLoad>
                </Scripts>
            </Frame>
            
            <Button name="$parentCloseButton" parentKey="CloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-12" y="-12"/>
                </Anchors>
            </Button>
        </Frames>
        
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground" parentKey="Background" setAllPoints="true"/>
            </Layer>

            <Layer level="ARTWORK">
                <FontString name="$parentName" parentKey="Name" justifyH="LEFT" inherits="GameFontNormalHuge">
                    <Size x="0" y="20"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="148" y="0"/>
                        <Anchor point="RIGHT" x="-42" y="0"/>
                    </Anchors>
                </FontString>
                
                <FontString name="$parentText" parentKey="Text" justifyH="LEFT" justifyV="TOP" inherits="GameFontHighlightLarge">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentName" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
                        <Anchor point="BOTTOMRIGHT" x="-42" y="12"/>
                    </Anchors>
                </FontString>
            </Layer>

            <Layer level="OVERLAY">
                <Texture parentKey="Sheen" hidden="true" alphaMode="ADD">
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentName" x="-8"/>
                    </Anchors>

                    <Animations>
                        <AnimationGroup parentKey="Anim" inherits="AnimationOneShotTemplate">
                            <Alpha order="1" duration="0" change="-1"/>
                            <Scale order="1" scaleX="0.25" scaleY="1" duration="0">
                                <Origin point="LEFT">
                                    <Offset x="0" y="0"/>
                                </Origin>
                            </Scale>

                            <Alpha order="2" duration="0.5" change="0.7"/>
                            <Scale order="2" scaleX="3" scaleY="1" duration="1">
                                <Origin point="LEFT">
                                    <Offset x="0" y="0"/>
                                </Origin>
                            </Scale>
                            
                            <Alpha order="2" startDelay="0.5" duration="0.5" change="-1"/>
                        </AnimationGroup>
                    </Animations>
                </Texture>

                <Texture parentKey="TextSheen" hidden="true" alphaMode="ADD">
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentText" x="-8" y="16"/>
                    </Anchors>

                    <Animations>
                        <AnimationGroup parentKey="Anim" inherits="AnimationOneShotTemplate">
                            <Alpha order="1" duration="0" change="-1"/>
                            <Scale order="1" scaleX="0.25" scaleY="1" duration="0">
                                <Origin point="LEFT">
                                    <Offset x="0" y="0"/>
                                </Origin>
                            </Scale>

                            <Alpha order="2" duration="0.5" change="0.7"/>
                            <Scale order="2" scaleX="3" scaleY="1" duration="1">
                                <Origin point="LEFT">
                                    <Offset x="0" y="0"/>
                                </Origin>
                            </Scale>

                            <Alpha order="2" startDelay="0.5" duration="0.5" change="-1"/>
                        </AnimationGroup>
                    </Animations>
                </Texture>
            </Layer>
        </Layers>
        
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "TalkingHeadFrameMixin")
            </OnLoad>
            <OnEvent function="OnEventToMethod"/>
        </Scripts>
        
        <Animations>
            <AnimationGroup parentKey="FadeIn" inherits="AnimationShowOnPlayTemplate">
                <Alpha order="1" duration="0" change="-1"/>
                <Alpha order="2" duration="0.25" change="1"/>
            </AnimationGroup>
            
            <AnimationGroup parentKey="FadeOut" inherits="AnimationHideOnFinishTemplate">
                <Alpha order="1" duration="0.25" change="-1"/>
            </AnimationGroup>
        </Animations>
    </Button>
</Ui>