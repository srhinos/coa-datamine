<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="CircularStatusBar.lua"/>

    <Frame name="CircularStatusBarTemplate" virtual="true">
        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentBL" parentKey="BL">
                    <Anchors>
                        <Anchor point="TOPRIGHT" relativePoint="CENTER"/>
                        <Anchor point="BOTTOMLEFT"/>
                    </Anchors>

                    <TexCoords left="0" right="0.5" top="0.5" bottom="1"/>
                </Texture>

                <Texture name="$parentTL" parentKey="TL">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" relativePoint="CENTER"/>
                        <Anchor point="TOPLEFT"/>
                    </Anchors>

                    <TexCoords left="0" right="0.5" top="0" bottom="0.5"/>
                </Texture>

                <Texture name="$parentTR" parentKey="TR">
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativePoint="CENTER"/>
                        <Anchor point="TOPRIGHT"/>
                    </Anchors>

                    <TexCoords left="0.5" right="1" top="0" bottom="0.5"/>
                </Texture>

                <Texture name="$parentBR" parentKey="BR">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="CENTER"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>

                    <TexCoords left="0.5" right="1" top="0.5" bottom="1"/>
                </Texture>
            </Layer>
        </Layers>

        <Frames>
            <ScrollFrame name="$parentScrollFrame" parentKey="ScrollFrame">
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativePoint="CENTER"/>
                    <Anchor point="TOPRIGHT"/>
                </Anchors>

                <ScrollChild>
                    <Frame name="$parentChild" parentKey="Child"/>
                </ScrollChild>
            </ScrollFrame>
        </Frames>

        <Scripts>
            <OnLoad>
                Mixin(self, "CircularStatusBarMixin")
                self:OnLoad()
            </OnLoad>
        </Scripts>
    </Frame>
</Ui>