<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="CurrencyBar.lua"/>
    
    <FontString name="AnimatedCurrencyFontTemplate" justifyH="LEFT" inherits="GameFontHighlightMedium" alpha="0.0" virtual="true">
        <Animations>
            <AnimationGroup parentKey="Animation">
                <Alpha parentKey="Alpha1" change="1" order="1" duration="0.2" smoothing="IN"/>
                <Translation parentKey="Translation" duration="1" offsetX="0" offsetY="30" smoothing="IN_OUT" order="1"/>
                <Alpha parentKey="Alpha2" startDelay="0.3" change="-1" duration="0.7" order="1" smoothing="OUT"/>
            </AnimationGroup>
        </Animations>
    </FontString>

    <Frame name="CurrencyBarTemplate" inherits="ThreeSliceTemplate" virtual="true">
        <Size x="100" y="20"/>
        
        
        <Attributes>
            <Attribute name="atlasName" value="common-coinbox"/>
        </Attributes>
        
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "CurrencyBarMixin")
            </OnLoad>
        </Scripts>
    </Frame>
    
    <Button name="CurrencyBarItemTemplate" virtual="true">
        <Size x="42" y="20"/>
        
        <Layers>
            <Layer>
                <Texture name="$parentIcon" parentKey="Icon">
                    <Size x="14" y="14"/>
                    <Anchors>
                        <Anchor point="RIGHT" x="-4"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString name="$parentAnimatedText" parentKey="AnimatedText" inherits="AnimatedCurrencyFontTemplate">
                    <Anchors>
                        <Anchor point="CENTER" relativeTo="$parentIcon" relativePoint="CENTER" x="0" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "CurrencyBarItemMixin")
            </OnLoad>
        </Scripts>
        
        <ButtonText name="$parentText" parentKey="Text" justifyH="RIGHT" inherits="NumberFontNormal">
            <Anchors>
                <Anchor point="LEFT" x="4" y="1"/>
                <Anchor point="RIGHT" relativeTo="$parentIcon" relativePoint="LEFT" x="-2" y="1"/>
            </Anchors>
        </ButtonText>
        
        <PushedTextOffset x="0" y="0"/>
    </Button>

    <Button name="CurrencyBarClassicItemTemplate" inherits="CurrencyBarItemTemplate" virtual="true">
        <Scripts>
            <OnLoad>
                self.Text:SetFontObject(GameFontNormalSmall)
                self.Text:SetVertexColor(1, 1, 1, 1)
                MixinAndLoadScripts(self, "CurrencyBarItemMixin")
            </OnLoad>
        </Scripts>
    </Button>

    <Frame name="CurrencyBarClassicTemplate" inherits="CurrencyBarTemplate" virtual="true">
        <Size x="100" y="19"/>

        <Attributes>
            <Attribute name="atlasName" value="currencyBox-Old"/>
            <Attribute name="ItemTemplate" value="CurrencyBarClassicItemTemplate"/>
            <Attribute name="loadMagicButton" value="true"/>
        </Attributes>

        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "CurrencyBarMixin")

                if self:GetAttribute("loadMagicButton") == "true" then
                    MagicButton_OnLoad(self)
                end
            </OnLoad>
        </Scripts>
    </Frame>
</Ui>