<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="SuperTracker.lua"/>

    <Frame name="SuperTracker" parent="WorldFrame" frameStrata="BACKGROUND">
        <Size x="100" y="100"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentIcon" parentKey="Icon">
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
                <FontString name="$parentDistanceText" parentKey="DistanceText" inherits="GameFontNormal" justifyV="TOP">
                    <Size x="0" y="20"/>
                    <Anchors>
                        <Anchor point="TOP" relativeTo="$parentIcon" relativePoint="BOTTOM" x="0" y="-8"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "SuperTrackerMixin")
            </OnLoad>
        </Scripts>
    </Frame>
</Ui>