    <Script file="ActionButton.lua"/>
    <CheckButton name="ActionBarButtonTemplate" inherits="SecureActionButtonTemplate, QuickKeybindButtonTemplate, ActionButtonTemplate" virtual="true">
        <Scripts>
            <OnLoad>
                self._isActionBarButton = true
                SecureActionButton_OnLoad(self)
                ActionButton_OnLoad(self);
            </OnLoad>
            <OnShow>
                self:QuickKeybindButtonOnShow()
            </OnShow>
            <OnHide>
                self:QuickKeybindButtonOnHide()
            </OnHide>
            <OnAttributeChanged>
                ActionButton_UpdateAction(self, name, value);
                SecureActionButton_OnAttributeChanged(self, name, value)
            </OnAttributeChanged>
            <OnEvent>
                ActionButton_OnEvent(self, event, ...);
            </OnEvent>
            <PostClick>
                ActionButton_UpdateState(self, button, down);
            </PostClick>
            <OnDragStart>
                if ( LOCK_ACTIONBAR ~= "1" or IsModifiedClick("PICKUPACTION") ) then
                    PickupAction(self.action);
                    ActionButton_UpdateState(self);
                    ActionButton_UpdateFlash(self);
                end
            </OnDragStart>
            <OnReceiveDrag>
                PlaceAction(self.action);
                ActionButton_UpdateState(self);
                ActionButton_UpdateFlash(self);
            </OnReceiveDrag>
            <OnEnter>
                self:QuickKeybindButtonOnEnter()
                ActionButton_SetTooltip(self);
            </OnEnter>
            <OnLeave>
                self:QuickKeybindButtonOnLeave()
                GameTooltip:Hide();
            </OnLeave>
            <OnUpdate>
                ActionButton_OnUpdate(self, elapsed);
            </OnUpdate>
        </Scripts>
    </CheckButton>
