<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="MysticEnchantPanel.lua"/>
    
    <Button name="MysticEnchantPanelItemTemplate" inherits="ScrollListItemTextTemplate" virtual="true">
        <Size x="190" y="52"/>
        
        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentIcon" parentKey="Icon">
                    <Size x="32" y="32"/>
                    <Anchors>
                        <Anchor point="CENTER" relativePoint="LEFT" x="30"/>
                    </Anchors>
                </Texture>
            </Layer>
            
            <Layer level="OVERLAY">
                <Texture name="$parentQualityBorder" parentKey="QualityBorder">
                    <Anchors>
                        <Anchor point="CENTER" relativeTo="$parentIcon" y="1"/>
                    </Anchors>
                </Texture>

                <FontString name="$parentCount" parentKey="Count" inherits="GameFontHighlightSmall">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "MysticEnchantPanelItemMixin")
            </OnLoad>
        </Scripts>
        
        <PushedTextOffset x="0" y="0"/>
        
        <ButtonText inherits="GameFontHighlightSmall" justifyH="LEFT">
            <Size x="118" y="40"/>
            <Anchors>
                <Anchor point="TOPLEFT" x="56" y="-4"/>
                <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
            </Anchors>
        </ButtonText>
        
        <NormalTexture>
            <Anchors>
                <Anchor point="TOPLEFT" y="4"/>
                <Anchor point="BOTTOM" y="-4"/>
            </Anchors>
        </NormalTexture>
        
        <HighlightTexture alphaMode="ADD">
            <Size x="32" y="32"/>
            <Anchors>
                <Anchor point="CENTER" relativeTo="$parentIcon"/>
            </Anchors>
        </HighlightTexture>
    </Button>

    <Button name="MysticEnchantArchitectTabItemTemplate" inherits="ScrollListItemTextTemplate" virtual="true">
        <Size x="190" y="52"/>

        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentIcon" parentKey="Icon">
                    <Size x="32" y="32"/>
                    <Anchors>
                        <Anchor point="CENTER" relativePoint="LEFT" x="30"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="OVERLAY">
                <Texture name="$parentQualityBorder" parentKey="QualityBorder">
                    <Anchors>
                        <Anchor point="CENTER" relativeTo="$parentIcon" y="1"/>
                    </Anchors>
                </Texture>

                <FontString name="$parentCount" parentKey="Count" inherits="GameFontHighlightSmall">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        
        <Frames>
            <Button name="$parentRemoveButton" parentKey="RemoveButton" alpha="0.4">
                <Size x="24" y="24"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-4" y="-4"/>
                </Anchors>
                
                <Scripts>
                    <OnLoad>
                    self:SetNormalAtlas("common-icon-redx")
                    self:SetHighlightAtlas("common-icon-redx")
                </OnLoad>
                    <OnEnter>
                        self:SetAlpha(1)
                    </OnEnter>
                    <OnLeave>
                        if not self:GetParent():IsMouseOver() then
                            self:SetAlpha(0.4)
                        end
                    </OnLeave>
                    <OnClick>
                        self:GetParent():Remove()
                    </OnClick>
                </Scripts>
                
                <HighlightTexture alphaMode="ADD"/>
            </Button>
            
            <Button name="$parentAddStacksButton" parentKey="AddStacksButton" alpha="0.4">
                <Size x="11" y="11"/>
                <Anchors>
                    <Anchor point="RIGHT" relativeTo="$parentCount" relativePoint="LEFT" x="-15"/>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        self:SetNormalAtlas("Char-Stat-Plus")
                        self:SetHighlightAtlas("Char-Stat-Plus")
                    </OnLoad>
                    <OnEnter>
                        self:SetAlpha(1)
                    </OnEnter>
                    <OnLeave>
                        if not self:GetParent():IsMouseOver() then
                            self:SetAlpha(0.4)
                        end
                    </OnLeave>
                    <OnClick>
                        self:GetParent():AddStacks()
                    </OnClick>
                </Scripts>

                <HighlightTexture alphaMode="ADD"/>
            </Button>

            <Button name="$parentRemoveStacksButton" parentKey="RemoveStacksButton" alpha="0.4">
                <Size x="11" y="5"/>
                <Anchors>
                    <Anchor point="RIGHT" relativeTo="$parentCount" relativePoint="LEFT" x="-2"/>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        self:SetNormalAtlas("Char-Stat-Minus")
                        self:SetHighlightAtlas("Char-Stat-Minus")
                    </OnLoad>
                    <OnEnter>
                        self:SetAlpha(1)
                    </OnEnter>
                    <OnLeave>
                        if not self:GetParent():IsMouseOver() then
                            self:SetAlpha(0.4)
                        end
                    </OnLeave>
                    <OnClick>
                        self:GetParent():RemoveStacks()
                    </OnClick>
                </Scripts>
                
                <HighlightTexture alphaMode="ADD"/>
            </Button>
        </Frames>

        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "ECArchitectTabItemMixin")
            </OnLoad>
        </Scripts>

        <PushedTextOffset x="0" y="0"/>

        <ButtonText inherits="GameFontHighlightSmall" justifyH="LEFT">
            <Size x="118" y="40"/>
            <Anchors>
                <Anchor point="TOPLEFT" x="56" y="-4"/>
                <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
            </Anchors>
        </ButtonText>

        <NormalTexture>
            <Anchors>
                <Anchor point="TOPLEFT" y="4"/>
                <Anchor point="BOTTOM" y="-4"/>
            </Anchors>
        </NormalTexture>

        <HighlightTexture alphaMode="ADD">
            <Size x="32" y="32"/>
            <Anchors>
                <Anchor point="CENTER" relativeTo="$parentIcon"/>
            </Anchors>
        </HighlightTexture>
    </Button>

    <Frame name="MysticEnchantPanelTemplate" hidden="true" inherits="StandardProportionalScrollListTemplate" virtual="true">
        <Size x="162" y="352"/>
    
        <Anchors>
            <Anchor point="TOPLEFT" x="2" y="-4"/>
        </Anchors>
        
        <Layers>
            <Layer>
                <Texture name="$parentBackground" parentKey="Background" setAllPoints="true"/>
            </Layer>
        </Layers>
        
    </Frame>
    
    <Frame name="AscensionCharacterMysticEnchantPanel" parent="AscensionCharacterFrameRightInset" inherits="MysticEnchantPanelTemplate">
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "MysticEnchantPanelMixin")
            </OnLoad>
        </Scripts>
    </Frame>
</Ui>