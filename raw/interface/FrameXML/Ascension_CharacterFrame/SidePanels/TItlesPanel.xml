<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="TitlesPanel.lua"/>
    
    <Button name="TitlesPanelItemTemplate" inherits="ScrollListItemTextTemplate" virtual="true">
        <Size x="0" y="18"/>

        <Layers>
            <Layer level="OVERLAY">
                <Texture name="$parentActive" parentKey="Active" alphaMode="ADD" alpha="0.5">
                    <Size x="162" y="48"/>
                    <Anchors>
                        <Anchor point="LEFT" y="-1"/>
                        <Anchor point="RIGHT" y="-1"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad>
                MixinAndLoad(self, "TitlePanelItemMixin")
            </OnLoad>
        </Scripts>

        <NormalTexture setAllPoints="true" alphaMode="ADD" alpha="0.4">
            <Size x="162" y="48"/>
            <Anchors>
                <Anchor point="LEFT"/>
                <Anchor point="RIGHT"/>
            </Anchors>
        </NormalTexture>

        <HighlightTexture parentKey="HighlightTexture"/>

        <ButtonText inherits="GameFontHighlightSmall" maxLines="1">
            <Anchors>
                <Anchor point="LEFT" x="5"/>
                <Anchor point="RIGHT" x="-5"/>
            </Anchors>
        </ButtonText>
        
        <PushedTextOffset x="1" y="0"/>
    </Button>
    
    <Frame name="AscensionCharacterTitlesPanel" parent="AscensionCharacterFrameRightInset" hidden="true" inherits="StandardProportionalScrollListTemplate">
        <Size x="162" y="352"/>

        <Anchors>
            <Anchor point="TOPLEFT" x="2" y="-4"/>
        </Anchors>
        
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground" parentKey="Background" setAllPoints="true"/>
            </Layer>
        </Layers>
        
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "TitlesPanelMixin")
            </OnLoad>
        </Scripts>
    </Frame>
</Ui>