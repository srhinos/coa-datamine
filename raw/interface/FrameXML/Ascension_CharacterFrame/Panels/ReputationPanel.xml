<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="ReputationPanel.lua"/>
    
    <Button name="ReputationPanelItemTemplate" inherits="ScrollListItemTemplate" virtual="true">
        <Size x="295" y="20"/>

        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentBackground" parentKey="Background" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar">
                    <Size x="0" y="21"/>
                    <Anchors>
                        <Anchor point="LEFT"/>
                        <Anchor point="RIGHT" x="-4"/>
                    </Anchors>
                    <TexCoords left="0.0" right="0.7578125" top="0.0" bottom="0.328125"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString name="$parentFactionName" parentKey="FactionName" inherits="GameFontHighlightSmall" justifyH="LEFT">
                    <Size x="135" y="10"/>
                </FontString>
                <Texture name="$parentFactionBadge" parentKey="FactionBadge">
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentFactionName" relativePoint="RIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <Frames>
            <Button name="$parentExpandOrCollapseButton" parentKey="ExpandOrCollapseButton">
                <Size x="13" y="13"/>
                <Anchors>
                    <Anchor point="LEFT" x="3" y="0"/>
                </Anchors>
                <HitRectInsets left="1" right="-4" top="-2" bottom="-2"/>
                <Scripts>
                    <OnClick>
                        PlaySound(SOUNDKIT.MINI_MAP_ZOOM_70)
                        if self:GetParent().isCollapsed then
                            ExpandFactionHeader(self:GetParent().index);
                        else
                            CollapseFactionHeader(self:GetParent().index);
                        end
                    </OnClick>
                </Scripts>
                <NormalTexture file="Interface\Buttons\UI-MinusButton-UP">
                    <Size x="16" y="16"/>
                    <Anchors>
                        <Anchor point="LEFT" x="3" y="0"/>
                    </Anchors>
                </NormalTexture>
                <HighlightTexture name="$parentHighlight" file="Interface\Buttons\UI-PlusButton-Hilight" alphaMode="ADD">
                    <Size x="16" y="16"/>
                    <Anchors>
                        <Anchor point="LEFT" x="3" y="0"/>
                    </Anchors>
                </HighlightTexture>
            </Button>

            <StatusBar name="$parentReputationBar" parentKey="ReputationBar" drawLayer="BORDER" minValue="0" maxValue="1" defaultValue="1">
                <Size x="101" y="13"/>
                <Anchors>
                    <Anchor point="RIGHT" x="0" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <Texture name="$parentAtWarHighlight2" parentKey="AtWarHighlight2" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar" alphaMode="ADD" hidden="true">
                            <Size x="103" y="17"/>
                            <Anchors>
                                <Anchor point="TOPRIGHT"/>
                            </Anchors>
                            <TexCoords left="0" right="0.40234375" top="0.734375" bottom="1.0"/>
                        </Texture>
                        <Texture name="$parentAtWarHighlight1" parentKey="AtWarHighlight1" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar" alphaMode="ADD" hidden="true">
                            <Size x="0" y="17"/>
                            <Anchors>
                                <Anchor point="RIGHT" relativeTo="$parentAtWarHighlight2" relativePoint="LEFT"/>
                            </Anchors>
                            <TexCoords left="0.25390625" right="1" top="0.375" bottom="0.640625"/>
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <Texture name="$parentLeftTexture" parentKey="LeftTexture" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar">
                            <Size x="62" y="21"/>
                            <Anchors>
                                <Anchor point="LEFT"/>
                            </Anchors>
                            <TexCoords left="0.691" right="1.0" top="0.047" bottom="0.281"/>
                        </Texture>
                        <Texture name="$parentRightTexture" parentKey="RightTexture" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar">
                            <Size x="42" y="21"/>
                            <Anchors>
                                <Anchor point="LEFT" relativeTo="$parentLeftTexture" relativePoint="RIGHT"/>
                            </Anchors>
                            <TexCoords left="0.0" right="0.164" top="0.3906" bottom="0.625"/>
                        </Texture>
                        <FontString name="$parentFactionStanding" parentKey="FactionStanding" inherits="GameFontHighlightSmall" text="Revered">
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                    <Layer level="OVERLAY">
                        <Texture name="$parentHighlight2" parentKey="Highlight2" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar-Highlight" alphaMode="ADD" hidden="true">
                            <Size x="17" y="28"/>
                            <Anchors>
                                <Anchor point="RIGHT" x="4" y="0"/>
                            </Anchors>
                            <TexCoords left="0" right="0.06640625" top="0.4375" bottom="0.875"/>
                        </Texture>
                        <Texture name="$parentHighlight1" parentKey="Highlight1" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar-Highlight" alphaMode="ADD" hidden="true">
                            <Size x="0" y="28"/>
                            <Anchors>
                                <Anchor point="RIGHT" relativeTo="$parentHighlight2" relativePoint="LEFT"/>
                            </Anchors>
                            <TexCoords left="0" right="1" top="0" bottom="0.4375"/>
                        </Texture>
                    </Layer>
                </Layers>
                <BarTexture file="Interface\PaperDollInfoFrame\UI-Character-Skills-Bar"/>
                <BarColor r=".25" g=".25" b=".75"/>
            </StatusBar>
        </Frames>

        <Scripts>
            <OnLoad>
                MixinAndLoad(self, "ReputationBarMixin")
            </OnLoad>
        </Scripts>
        
        <NormalTexture/>
        <HighlightTexture/>
    </Button>

    <Frame name="AscensionReputationPanel" inherits="CharacterFramePanelTemplate" hidden="true">
        <Frames>
            <Frame name="$parentScrollList" parentKey="ScrollList" inherits="StandardProportionalScrollListTemplate">
                <Size x="354" y="354"/>
                <Anchors>
                    <Anchor point="TOPLEFT" y="-2"/>
                </Anchors>
            </Frame>

            <Frame name="$parentDetailsFrame" parentKey="DetailsFrame" enableMouse="true" hidden="true">
                <Size x="212" y="203"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPRIGHT"/>
                </Anchors>

                <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
                    <BackgroundInsets left="11" right="12" top="12" bottom="11"/>
                    <TileSize val="32"/>
                    <EdgeSize val="32"/>
                </Backdrop>

                <Layers>
                    <Layer level="ARTWORK">
                        <FontString name="$parentName" parentKey="Name" inherits="GameFontNormal" justifyH="LEFT">
                            <Size x="160" y="0"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="20" y="-21"/>
                            </Anchors>
                        </FontString>

                        <FontString name="$parentDescription" parentKey="Description" inherits="ReputationDetailFont" justifyH="LEFT">
                            <Size x="170" y="0"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeTo="$parentName" relativePoint="BOTTOMLEFT" x="0" y="-2"/>
                            </Anchors>
                        </FontString>

                        <Texture file="Interface\PaperDollInfoFrame\UI-Character-Reputation-DetailBackground">
                            <Size x="256" y="128"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="11" y="-11"/>
                            </Anchors>
                        </Texture>
                    </Layer>

                    <Layer level="OVERLAY">
                        <Texture name="$parentDetailCorner" file="Interface\DialogFrame\UI-DialogBox-Corner">
                            <Size x="32" y="32"/>
                            <Anchors>
                                <Anchor point="TOPRIGHT" x="-6" y="-7"/>
                            </Anchors>
                        </Texture>

                        <Texture name="$parentDetailDivider" file="Interface\DialogFrame\UI-DialogBox-Divider">
                            <Size x="256" y="32"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="9" y="-131"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>

                <Frames>
                    <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
                        <Anchors>
                            <Anchor point="TOPRIGHT" x="-3" y="-3"/>
                        </Anchors>
                    </Button>

                    <CheckButton name="$parentAtWarToggle" parentKey="AtWarToggle">
                        <Size x="26" y="26"/>
                        <Anchors>
                            <Anchor point="BOTTOMLEFT" x="14" y="34"/>
                        </Anchors>
                        <Scripts>
                            <OnClick>
                                self:GetParent():GetParent():ToggleAtWar(GetSelectedFaction())
                                if self:GetBoolValue() then
                                    PlaySound("igMainMenuOptionCheckBoxOn")
                                else
                                    PlaySound("igMainMenuOptionCheckBoxOff")
                                end
                            </OnClick>
                            <OnEnter>
                                GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                                GameTooltip:SetText(REPUTATION_AT_WAR_DESCRIPTION, nil, nil, nil, nil, 1)
                                GameTooltip:Show()
                            </OnEnter>
                            <OnLeave function="GameTooltip_Hide"/>
                        </Scripts>
                        
                        <ButtonText  name="$parentText" parentKey="Text" text="AT_WAR" inherits="GameFontRedSmall">
                            <Anchors>
                                <Anchor point="LEFT" relativePoint="RIGHT" x="-2" y="0"/>
                            </Anchors>
                        </ButtonText>
                        
                        <NormalFont style="GameFontRedSmall"/>
                        <DisabledFont style="GameFontDisableSmall"/>

                        <NormalTexture file="Interface\Buttons\UI-CheckBox-Up"/>
                        <PushedTexture file="Interface\Buttons\UI-CheckBox-Down"/>
                        <HighlightTexture file="Interface\Buttons\UI-CheckBox-Highlight" alphaMode="ADD"/>
                        <CheckedTexture file="Interface\Buttons\UI-CheckBox-SwordCheck">
                            <Size x="32" y="32"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="3" y="-5"/>
                            </Anchors>
                        </CheckedTexture>
                        <DisabledCheckedTexture file="Interface\Buttons\UI-CheckBox-Check-Disabled"/>
                    </CheckButton>

                    <CheckButton name="$parentInactiveToggle" parentKey="InactiveToggle" inherits="OptionsSmallCheckButtonTemplate">
                        <Size x="26" y="26"/>
                        <Anchors>
                            <Anchor point="LEFT" relativeTo="$parentAtWarToggleText" relativePoint="RIGHT" x="3" y="0"/>
                        </Anchors>
                        <HitRectInsets left="0" right="0" top="0" bottom="0"/>
                        <Scripts>
                            <OnLoad>
                                self.Text = _G[self:GetName().."Text"]
                                self.Text:SetText(MOVE_TO_INACTIVE)
                            </OnLoad>
                            <OnClick>
                                if self:GetBoolValue() then
                                    PlaySound("igMainMenuOptionCheckBoxOn")
                                    SetFactionInactive(GetSelectedFaction())
                                else
                                    PlaySound("igMainMenuOptionCheckBoxOff")
                                    SetFactionActive(GetSelectedFaction())
                                end
                            </OnClick>
                            <OnEnter>
                                GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                                GameTooltip:SetText(REPUTATION_MOVE_TO_INACTIVE, nil, nil, nil, nil, 1)
                                GameTooltip:Show()
                            </OnEnter>
                            <OnLeave function="GameTooltip_Hide"/>
                            <OnDisable>
                                self.Text:SetTextColor(GRAY_FONT_COLOR:GetRGB())
                            </OnDisable>
                            <OnEnable>
                                self.Text:SetTextColor(NORMAL_FONT_COLOR:GetRGB())
                            </OnEnable>
                        </Scripts>
                    </CheckButton>

                    <CheckButton name="$parentWatchToggle" parentKey="WatchToggle" inherits="OptionsSmallCheckButtonTemplate">
                        <Size x="26" y="26"/>
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeTo="$parentAtWarToggle" relativePoint="BOTTOMLEFT" x="0" y="3"/>
                        </Anchors>
                        <HitRectInsets left="0" right="0" top="0" bottom="0"/>
                        <Scripts>
                            <OnLoad>
                                self.Text = _G[self:GetName().."Text"]
                                self.Text:SetText(SHOW_FACTION_ON_MAINSCREEN)
                            </OnLoad>
                            <OnClick>
                                if self:GetBoolValue() then
                                    PlaySound("igMainMenuOptionCheckBoxOn")
                                    self:GetParent():GetParent():SetWatchedFaction(GetSelectedFaction())
                                else
                                    PlaySound("igMainMenuOptionCheckBoxOff")
                                    self:GetParent():GetParent():SetWatchedFaction(0)
                                end
                            </OnClick>
                            <OnEnter>
                                GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                                GameTooltip:SetText(REPUTATION_SHOW_AS_XP, nil, nil, nil, nil, 1)
                                GameTooltip:Show()
                            </OnEnter>
                            <OnLeave function="GameTooltip_Hide"/>
                        </Scripts>
                    </CheckButton>
                </Frames>
                
                <Scripts>
                    <OnHide>
                        SetSelectedFaction(0)
                        if self:GetParent():IsShown() then
                            self:GetParent().ScrollList:RefreshScrollFrame()
                        end
                    </OnHide>
                </Scripts>
            </Frame>
        </Frames>
        
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "ReputationPanelMixin")
            </OnLoad>
        </Scripts>
    </Frame>
</Ui>