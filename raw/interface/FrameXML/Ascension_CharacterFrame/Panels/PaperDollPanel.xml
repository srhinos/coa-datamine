                    </Button>
                    <Button name="AscensionCharacterHandsSlot" inherits="CharacterItemSlotButtonRightTemplate">
                        <Anchors>
                            <Anchor point="TOPRIGHT" x="-4" y="-2"/>
                        </Anchors>
                        <Attributes>
                            <Attribute name="invslot" value="HandsSlot"/>
