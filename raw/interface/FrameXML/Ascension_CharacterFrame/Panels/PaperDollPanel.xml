                                self.FrameExtraLeft:SetAtlas("Char-Slot-Bottom-Left", Const.TextureKit.UseAtlasSize)
                                self.FrameExtraRight:SetAtlas("Char-Slot-Bottom-Right", Const.TextureKit.UseAtlasSize)
                                MixinAndLoadScripts(self, "CharacterItemSlotButtonMixin")
                                self:SetScale(0.6)
                            </OnLoad>
                        </Scripts>
                    </Button>
                </Frames>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "PaperDollPanelMixin")
            </OnLoad>
