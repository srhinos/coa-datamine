    </Button>
    
    <Frame name="AscensionPaperDollPanel" inherits="CharacterFramePanelTemplate">
        <Frames>
            <PlayerModel name="$parentModel" parentKey="Model" inherits="NineSlicePanelTemplate2">
                <Size x="280" y="326"/>
                <Anchors>
                    <Anchor point="TOP" y="-4"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentBackground" parentKey="Background" setAllPoints="true"/>
                    </Layer>

                    <Layer level="BORDER">
                        <Texture name="$parentBackgroundOverlay" parentKey="BackgroundOverlay" setAllPoints="true">
                            <Color r="0" g="0" b="0"/>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnLoad>
                        self:SetFacing(0.45)
                        MixinAndLoad(self, "ModelMixin")
                        self:SetEnableDragRotation(true)
                        self:SetEnableScrollZoom(true)
                        self:SetEnableDragMove(true)
                        self:SetDragScale(0.001)
                        self:SetMaxPosOffset(0.5, 0.5)
                        self:SetMinMaxDistance(-1.4, 1.4)
                        MixinAndLoad(self, "NineSlicePanelMixin")
                    </OnLoad>
                    <OnReceiveDrag>
                        AutoEquipCursorItem()
                    </OnReceiveDrag>
                </Scripts>
                <Attributes>
                    <Attribute name="layoutType" value="InnerPaperDollBorder"/>
                </Attributes>
            </PlayerModel>
            
            <Frame name="$parentFelCommutationNotice" enableMouse="true" parentKey="FelCommutationNotice" hidden="true">
                <Size x="274" y="72"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentModel" x="4" y="-1"/>
                    <Anchor point="TOPRIGHT" relativeTo="$parentModel" x="-4" y="-1"/>
                </Anchors>
                
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture name="$parentArtwork" parentKey="Artwork">
                            <Size x="436" y="35"/>
                            <Anchors>
                                <Anchor point="TOP"/>
                            </Anchors>
                        </Texture>
                    </Layer>

                    <Layer level="OVERLAY">
                        <FontString name="$parentLabel" parentKey="Label" text="FEL_COMMUTATION_POTENTIAL_LOSS" inherits="GameFontNormalSmall">
                            <Anchors>
                                <Anchor point="TOP" y="-6"/>
                            </Anchors>
                        </FontString>

                        <FontString name="$parentCost" parentKey="Cost" inherits="GameFontNormalSmall">
                            <Anchors>
                                <Anchor point="TOP" relativeTo="$parentLabel" relativePoint="BOTTOM" y="-4"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                
                <Scripts>
                    <OnEnter>
                        GameTooltip:SetOwner(self, "ANCHOR_TOP")
                        GameTooltip:SetText(FEL_COMMUTATION, 1, 1, 1, 1)
                        GameTooltip:AddLine(FEL_COMMUTATION_DESC, nil, nil, nil, true)
                        GameTooltip:Show()
                    </OnEnter>
                    <OnLeave function="GameTooltip_Hide"/>
                </Scripts>
            </Frame>

            <Frame name="$parentItemsFrame" parentKey="ItemsFrame" setAllPoints="true">
                <Frames>
                    <Button name="AscensionCharacterHeadSlot" inherits="CharacterItemSlotButtonLeftTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT" x="4" y="-2"/>
                        </Anchors>
                        <Attributes>
                            <Attribute name="invslot" value="HeadSlot"/>
                        </Attributes>
                    </Button>
                    <Button name="AscensionCharacterNeckSlot" inherits="CharacterItemSlotButtonLeftTemplate">
