                    </Button>
                    <Button name="AscensionCharacterRangedSlot" inherits="CharacterItemSlotButtonBottomTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeTo="AscensionCharacterSecondaryHandSlot" relativePoint="TOPRIGHT" x="5" y="0"/>
