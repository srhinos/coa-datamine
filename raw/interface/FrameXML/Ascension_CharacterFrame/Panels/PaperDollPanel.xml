                    </Button>
                    <Button name="AscensionCharacterMainHandSlot" inherits="CharacterItemSlotButtonBottomTemplate">
                        <Anchors>
                            <Anchor point="BOTTOM" x="-59" y="16"/>
                        </Anchors>
                        <Layers>
                            <Layer level="BACKGROUND">
                                <Texture parentKey="FrameExtra">
                                    <Anchors>
                                        <Anchor point="TOPRIGHT" relativeTo="$parentFrame" relativePoint="TOPLEFT"/>
                                    </Anchors>
                                </Texture>
                            </Layer>
                        </Layers>
                        <Scripts>
                            <OnLoad>
                                self.FrameExtra:SetAtlas("Char-Slot-Bottom-Left", Const.TextureKit.UseAtlasSize)
                                MixinAndLoadScripts(self, "CharacterItemSlotButtonMixin")
                            </OnLoad>
                        </Scripts>
                        <Attributes>
                            <Attribute name="invslot" value="MainHandSlot"/>
                        </Attributes>
                    </Button>
                    <Button name="AscensionCharacterSecondaryHandSlot" inherits="CharacterItemSlotButtonBottomTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeTo="AscensionCharacterMainHandSlot" relativePoint="TOPRIGHT" x="5" y="0"/>
                        </Anchors>
