                            <Anchor point="TOPLEFT" relativeTo="AscensionCharacterHeadSlot" relativePoint="BOTTOMLEFT"  x="0" y="-4"/>
                        </Anchors>
                        <Attributes>
                            <Attribute name="invslot" value="NeckSlot"/>
                        </Attributes>
                    </Button>
                    <Button name="AscensionCharacterShoulderSlot" inherits="CharacterItemSlotButtonLeftTemplate">
