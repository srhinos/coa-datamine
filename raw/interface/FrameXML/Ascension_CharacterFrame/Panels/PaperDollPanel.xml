                    </Button>

                    <Button name="AscensionCharacterAmmoSlot" inherits="CharacterItemSlotButtonBottomTemplate">
                        <Anchors>
                            <Anchor point="BOTTOMLEFT" relativeTo="AscensionCharacterRangedSlot" relativePoint="BOTTOMRIGHT" x="15" y="0"/>
                        </Anchors>
                        <Layers>
                            <Layer level="BACKGROUND">
                                <Texture parentKey="FrameExtraLeft">
                                    <Anchors>
                                        <Anchor point="TOPRIGHT" relativeTo="$parentFrame" relativePoint="TOPLEFT"/>
                                    </Anchors>
                                </Texture>
                            </Layer>
                            <Layer level="BACKGROUND">
                                <Texture parentKey="FrameExtraRight">
