<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="CharacterItemSlotButton.lua"/>
    <Script file="PaperDollPanel.lua"/>

    <Button name="ItemSlotButtonTemplate" inherits="ItemButtonTemplate" virtual="true">
        <Frames>
            <Cooldown name="$parentCooldown" parentKey="Cooldown" inherits="CooldownFrameTemplate"/>
        </Frames>
    </Button>
    
    <Button name="CharacterItemSlotButtonTemplate" inherits="ItemSlotButtonTemplate" virtual="true">
        <Layers>
            <Layer level="OVERLAY">
                <Texture parentKey="ignoreTexture" file="Interface\PaperDollInfoFrame\UI-GearManager-LeaveItem-Transparent">
                    <Size x="40" y="40"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <Frames>
            <Button name="$parentPopoutButton" parentKey="PopoutButton" inherits="EquipmentFlyoutPopoutButtonTemplate"/>
        </Frames>

        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "CharacterItemSlotButtonMixin")
            </OnLoad>
            <OnDragStart>
                self:OnClick("LeftButton")
            </OnDragStart>
            <OnReceiveDrag>
                self:OnClick("LeftButton")
            </OnReceiveDrag>
        </Scripts>
    </Button>

    <Button name="ItemSlotButtonLeftTemplate" inherits="ItemSlotButtonTemplate" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentFrame" parentKey="Frame">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-4"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Attributes>
            <Attribute name="position" value="left"/>
        </Attributes>
    </Button>
    
    <Button name="CharacterItemSlotButtonLeftTemplate" inherits="CharacterItemSlotButtonTemplate" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentFrame" parentKey="Frame">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-4"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Attributes>
            <Attribute name="position" value="left"/>
        </Attributes>
    </Button>

    <Button name="ItemSlotButtonRightTemplate" inherits="ItemSlotButtonTemplate" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentFrame" parentKey="Frame">
                    <Anchors>
                        <Anchor point="TOPRIGHT" x="4"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Attributes>
            <Attribute name="position" value="right"/>
        </Attributes>
    </Button>
    
    <Button name="CharacterItemSlotButtonRightTemplate" inherits="CharacterItemSlotButtonTemplate" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
