    <Button name="ItemSlotButtonBottomTemplate" inherits="ItemSlotButtonTemplate" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentFrame" parentKey="Frame">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-4" y="8"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Attributes>
            <Attribute name="position" value="bottom"/>
        </Attributes>
    </Button>
    
    <Button name="CharacterItemSlotButtonBottomTemplate" inherits="CharacterItemSlotButtonTemplate" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentFrame" parentKey="Frame">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-4" y="8"/>
