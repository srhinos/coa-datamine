<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="LoadoutListItem.lua"/>

    <Button name="LoadoutListItemTemplate" inherits="ScrollListItemTextTemplate" motionScriptsWhileDisabled="true" virtual="true">
        <Size x="195" y="40"/>

        <Frames>
            <Frame name="$parentIcon" parentKey="Icon" inherits="SpellIconTemplate">
                <Size x="34" y="34"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="3" y="-3"/>
                </Anchors>
            </Frame>

            <EditBox name="$parentEditBox" parentKey="EditBox" hidden="true" letters="18" inherits="InputBoxInstructionsTemplate">
                <Size x="142" y="20"/>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentIcon" relativePoint="RIGHT" x="14"/>
                </Anchors>
                <Scripts>
                    <OnShow>
                        self:SetText(self:GetParent():GetText() or "")
                        self:GetParent().Text:Hide()
                    </OnShow>
                    <OnHide>
                        self:GetParent().Text:Show()
                    </OnHide>
                    <OnEnterPressed>
                        self:GetParent():CommitNameChange()
                    </OnEnterPressed>
                    <OnEscapePressed>
                        self:GetParent():HideEditMode()
                    </OnEscapePressed>
                </Scripts>
            </EditBox>

            <Button name="$parentEdit" parentKey="Edit" inherits="BasicAtlasButtonTemplate">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-4" y="-4"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        self:GetParent():ToggleEditMode()
                    </OnClick>
                </Scripts>
                <Attributes>
                    <Attribute name="atlas" value="mechagon-projects"/>
                    <Attribute name="tooltipTitle" value="EQUIPMENT_MANAGER_EDIT"/>
                    <Attribute name="tooltipText" value="EQUIPMENT_MANAGER_EDIT_TOOLTIP"/>
                </Attributes>
            </Button>

            <Frame name="$parentExpandedContent" parentKey="ExpandedContent" enableMouse="true" hidden="true">
                <Size x="195" y="126"/>
                <Anchors>
                    <Anchor point="TOPLEFT" y="-40"/>
                    <Anchor point="TOPRIGHT" y="-40"/>
                </Anchors>

                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentBackground" parentKey="Background">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="2" y="-2"/>
                                <Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
                            </Anchors>
                        </Texture>
                    </Layer>

                    <Layer level="BORDER">
                        <Texture name="$parentBorder" parentKey="Border" setAllPoints="true"/>
                    </Layer>
                </Layers>

                <Frames>
                    <Button name="$parentActivateButton" parentKey="ActivateButton" text="ACTIVATE" inherits="SharedGoldRedButtonTemplate">
                        <Size x="102" y="28"/>
                        <Anchors>
                            <Anchor point="BOTTOM" y="8"/>
                        </Anchors>
                        <Scripts>
                            <OnClick>
                                self:GetParent():GetParent():ActivateLoadout()
                            </OnClick>
                        </Scripts>
                    </Button>
                </Frames>
            </Frame>
        </Frames>

        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "LoadoutListItemMixin")
            </OnLoad>
            <OnEvent function="OnEventToMethod"/>
        </Scripts>

        <PushedTextOffset x="0" y="0"/>

        <ButtonText parentKey="Text" inherits="GameFontNormalSmall2" justifyH="LEFT">
            <Size x="142" y="40"/>
            <Anchors>
                <Anchor point="TOPLEFT" x="46"/>
            </Anchors>
        </ButtonText>

        <NormalTexture>
            <Size x="147" y="40"/>
            <Anchors>
                <Anchor point="TOPLEFT" x="40"/>
                <Anchor point="TOPRIGHT"/>
            </Anchors>
        </NormalTexture>

        <HighlightTexture alphaMode="ADD">
            <Size x="147" y="40"/>
            <Anchors>
                <Anchor point="TOPLEFT" x="40"/>
                <Anchor point="TOPRIGHT"/>
            </Anchors>
        </HighlightTexture>
    </Button>
</Ui>