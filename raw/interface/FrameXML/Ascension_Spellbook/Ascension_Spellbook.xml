    <Button name="SpellbookProfessionExtraTemplate" inherits="SecureActionButtonTemplate" motionScriptsWhileDisabled="true" virtual="true">
        <Size x="18" y="18"/>
        <Layers>
            <Layer level="BORDER">
                <Texture name="$parentIcon" parentKey="Icon" setAllPoints="true"/>
            </Layer>

            <Layer level="ARTWORK">
                <Texture name="$parentIconBorder" parentKey="IconBorder">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentIcon" x="-1" y="1"/>
                        <Anchor point="BOTTOMRIGHT" relativeTo="$parentIcon" x="1" y="-1"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="HIGHLIGHT">
                <Texture name="$parentHighlight" parentKey="Highlight" alphaMode="ADD">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentIcon" x="-1" y="1"/>
                        <Anchor point="BOTTOMRIGHT" relativeTo="$parentIcon" x="1" y="-1"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        
        <Scripts>
            <OnLoad>
                SecureActionButton_OnLoad(self)
                self.IconBorder:SetAtlas("professionbook-icon-border", Const.TextureKit.IgnoreAtlasSize)
                self.Highlight:SetAtlas("bags-roundhighlight", Const.TextureKit.IgnoreAtlasSize)
                self:SetAttribute("type", "spellbook")
                self:RegisterForDrag("LeftButton")
            </OnLoad>
            <OnEnter>
                if self.spellID then
                    GameTooltip:SetOwner(self, "ANCHOR_TOP")
                    GameTooltip:SetHyperlink("spell:"..self.spellID)
                    GameTooltip:Show()
                end
            </OnEnter>
            <OnLeave function="GameTooltip_Hide"/>
            <OnDragStart>
                local spellIndex = self:GetAttribute("spell")
                local bookType = self:GetAttribute("bookType")
                if spellIndex and bookType and self:IsEnabled() == 1 then
                    PickupSpell(spellIndex, bookType)
                end
            </OnDragStart>
        </Scripts>
    </Button>

