<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Ascension-Addons/UI.xsd/main/UI.xsd">
    <Script file="RestartTimer.lua"/>

    <Frame name="RestartTimerFrame" parent="UIParent" enableMouse="true" inherits="BetterStatusBarTemplate" hidden="true">
        <Size x="200" y="16"/>
        <Anchors>
            <Anchor point="TOP" y="-8"/>
        </Anchors>

        <Layers>
            <Layer>
                <Texture name="$parentOverlay" parentKey="Overlay">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-4" y="4"/>
                        <Anchor point="BOTTOMRIGHT" x="4" y="-4"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <Attributes>
            <Attribute name="bar-atlas" value="ui-frame-bar-fill-green"/>
            <Attribute name="bar-color" value="0.6,0.6,0.6"/>
            <Attribute name="background-atlas" value="ChallengeMode-TimerBG-back"/>
        </Attributes>

        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "RestartTimerMixin")
            </OnLoad>
        </Scripts>
    </Frame>
</Ui>