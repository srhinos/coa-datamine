 "rules": [
  {"description":"You cannot use cosmetic pet items (Beastmaster's Whistles, Summoner's Stone, etc.)","f2":0,"f3":1,"name":"No Cosmetic Pet Items","ruleTypeToken":"CHALLENGE_RULES_TYPE_NO_COSMETIC_PET_ITEMS"},
  {"description":"Creature level scaling is disabled.","f2":0,"f3":1,"name":"No creature level scaling","ruleTypeToken":"CHALLENGE_RULES_TYPE_NO_CREATURE_LEVEL_SCALING"},
  {"description":"You are unaffected by energize effects unless you are in a rested area. This includes mana potions, spells that restore mana / rage / energy, or talents that restore mana / rage / energy.","f2":0,"f3":1,"name":"No Energizes Unless Resting","ruleTypeToken":"CHALLENGE_RULES_TYPE_NO_ENERGIZING_UNLESS_RESTED"},
  {"description":"You are unaffected by healing unless you are in a rested area. This includes Healing spells, bandages, health potions, or other players healing you.","f2":0,"f3":1,"name":"No Healing Unless Resting","ruleTypeToken":"CHALLENGE_RULES_TYPE_NO_HEALING_UNLESS_RESTED"},
  {"description":"You are not healed to full when you level up.","f2":0,"f3":1,"name":"No Health Restore On Level","ruleTypeToken":"CHALLENGE_RULES_TYPE_NO_HEALTH_REGENERATION_ON_LEVEL_UP"},
